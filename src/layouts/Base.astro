---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PlayerModal from '../components/PlayerModal.astro';
import FloatingCta from '../components/FloatingCta.astro';
import { t } from '../i18n/t';

import { jsonLdScript } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Alt text for the share image (defaults to a description of the default card). */
  ogImageAlt?: string;
  /** Pixel size of ogImage, when known. */
  ogImageSize?: [number, number];
  ogType?: 'website' | 'video.other' | 'profile';
  path: string;
  /** Structured data objects (schema.org), each rendered as one JSON-LD block. */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, ogImage: ogImageProp, ogImageAlt, ogImageSize, ogType = 'website', path, jsonLd = [] } = Astro.props;
const isDefaultOg = !ogImageProp;
const ogImage = ogImageProp || '/img/og-default.jpg';
const ogSize = isDefaultOg ? ([1200, 630] as [number, number]) : ogImageSize;
const ogAlt = ogImageAlt || (isDefaultOg ? t('seo.ogDefaultAlt') : title);
const site = Astro.site ?? new URL('https://threetotango.canimi.app');
const canonical = new URL(path, site).href;
const ogUrl = new URL(ogImage, site).href;
const umamiId = import.meta.env.PUBLIC_UMAMI_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#17322a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/fredoka-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/nunito-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t('brand.name')} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    {ogSize && <meta property="og:image:width" content={String(ogSize[0])} />}
    {ogSize && <meta property="og:image:height" content={String(ogSize[1])} />}
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={jsonLdScript(data)} />)}
    {
      umamiId && (
        <script defer src="https://stats.canimi.app/script.js" data-website-id={umamiId} />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t('meta.skip')}</a>
    <Header {path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <PlayerModal />
    {path !== '/tango-me' && <FloatingCta />}
    <script>
      import '../scripts/scroll-top';
      import '../scripts/pointer-fx';
      import '../scripts/track-clicks';
    </script>
  </body>
</html>
