---
import Base from '../layouts/Base.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { t } from '../i18n/t';
---

<Base title={`${t('gift.pageTitle')} | ${t('brand.name')}`} description={t('gift.pageDesc')} path="/gift">
  <section class="container gift">
    <h1>{t('gift.title')}</h1>
    <p class="sub">{t('gift.sub')}</p>

    <h2>{t('gift.youGet')}</h2>
    <ul class="gets">
      <li>{t('gift.item1')}</li>
      <li>{t('gift.item2')}</li>
      <li>{t('gift.item3')}</li>
    </ul>

    <SubscribeForm source="gift" />
    <p class="fine">{t('gift.unsubscribe')}</p>
  </section>
</Base>

<style>
  .gift {
    padding-block: var(--space-4);
    text-align: center;
  }
  .sub {
    color: var(--c-ink-2);
    margin-block: 0 var(--space-3);
  }
  .gets {
    display: inline-block;
    text-align: start;
    margin-block: 0 var(--space-4);
    padding-inline-start: 1.2rem;
  }
  .fine {
    color: var(--c-ink-2);
    font-size: 0.9rem;
    margin-block-start: var(--space-2);
  }
</style>
