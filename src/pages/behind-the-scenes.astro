---
import Base from '../layouts/Base.astro';
import { getEpisodes } from '../lib/site-episodes';
import { t } from '../i18n/t';
import en from '../i18n/en.json';

const latest = (await getEpisodes()).find((e) => e.thumbnailUrl) ?? null;
const steps = en.bts.steps;
---

<Base title={`${t('bts.title')} | ${t('brand.name')}`} description={t('bts.desc')} path="/behind-the-scenes">
  <div class="container wrap">
    <h1>{t('bts.title')}</h1>
    <p class="lead">{t('bts.intro')}</p>

    <h2 class="strip-title">{t('bts.stripTitle')}</h2>
    <ol class="strip">
      <li>
        <figure class="gilt"><img src="/img/house/bts-sketch-800.webp" width="800" height="600" alt="Pencil storyboard: three cats raid the fridge at night" loading="lazy" decoding="async" /></figure>
        <p>{steps[0]}</p>
      </li>
      <li>
        <figure class="gilt"><img src="/img/house/bts-still-800.webp" width="800" height="600" alt="The same fridge raid as a 3D still" loading="lazy" decoding="async" /></figure>
        <p>{steps[1]}</p>
      </li>
      {latest && (
        <li>
          <a class="gilt ep" href={`/episodes/${latest.slug}`}>
            <img src={latest.thumbnailUrl} width="360" height="640" alt={`${t('episodes.thumbAlt')} ${latest.title}`} loading="lazy" decoding="async" />
          </a>
          <p>{steps[2]}</p>
        </li>
      )}
    </ol>

    <div class="text">
      <h2>{t('bts.h1')}</h2>
      <p>{t('bts.p1')}</p>
      <h2>{t('bts.h2')}</h2>
      <p>{t('bts.p2')}</p>
      <h2>{t('bts.h3')}</h2>
      <p>{t('bts.p3')}</p>
      <p><a class="btn btn-lg" href="/tango-me">{t('cta.tangoFreeLong')}</a></p>
    </div>
  </div>
</Base>

<style>
  .wrap {
    padding-block: var(--space-4) var(--space-5);
  }
  h1,
  .lead,
  .text {
    max-inline-size: 42rem;
  }
  .lead {
    font-size: 1.25rem;
  }
  .text h2 {
    font-size: 1.6rem;
    margin-block-start: var(--space-4);
  }
  .strip-title {
    margin-block: var(--space-4) var(--space-3);
  }
  .strip {
    display: grid;
    grid-template-columns: 1.33fr 1.33fr 0.56fr;
    gap: var(--space-3);
    align-items: end;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .strip figure {
    margin: 0;
    --gilt-w: 9px;
  }
  .strip .gilt img {
    aspect-ratio: 4 / 3;
  }
  .strip .ep img {
    aspect-ratio: 9 / 16;
  }
  .strip p {
    margin: 0.8rem 0 0;
    color: var(--c-brass);
    font: 600 0.8rem / 1.3 var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  @media (max-width: 48rem) {
    .strip {
      grid-template-columns: 1fr 1fr;
    }
    .strip li:last-child {
      grid-column: span 2;
      justify-self: center;
      inline-size: 40%;
    }
  }
</style>
