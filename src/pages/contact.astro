---
import Base from '../layouts/Base.astro';
import { social } from '../data/social';
import { t } from '../i18n/t';
---

<Base title={`${t('contact.title')} | ${t('brand.name')}`} description={t('contact.desc')} path="/contact">
  <div class="container wrap">
    <h1>{t('contact.title')}</h1>
    <p>{t('contact.body')}</p>
    <p><a class="btn" href={social.instagram} target="_blank" rel="noopener">{t('contact.cta')}</a></p>
  </div>
</Base>

<style>
  .wrap {
    padding-block: var(--space-4);
    max-inline-size: 42rem;
  }
</style>
