---
import Base from '../../layouts/Base.astro';
import EpisodeGrid from '../../components/EpisodeGrid.astro';
import { getEpisodes } from '../../lib/site-episodes';
import { t } from '../../i18n/t';

const episodes = await getEpisodes();
---

<Base title={`${t('episodes.pageTitle')} | ${t('brand.name')}`} description={t('episodes.pageDesc')} path="/episodes">
  <div class="container page">
    <h1>{t('episodes.all')}</h1>
    <p class="lede intro">{t('episodes.pageDesc')}</p>
    <EpisodeGrid episodes={episodes} />
  </div>
</Base>

<style>
  .intro {
    margin-block: 0 var(--space-4);
  }
</style>
