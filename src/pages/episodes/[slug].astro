---
import Base from '../../layouts/Base.astro';
import EpisodeCard from '../../components/EpisodeCard.astro';
import EpisodeGrid from '../../components/EpisodeGrid.astro';
import { characters } from '../../data/characters';
import { getEpisodes } from '../../lib/site-episodes';
import type { CharacterId, Episode } from '../../lib/episodes';
import { breadcrumbLd, episodeDescription, episodeSummary, episodeTitle, videoLd } from '../../lib/seo';
import { t } from '../../i18n/t';

export async function getStaticPaths() {
  const list = await getEpisodes();
  return list.map((episode, i) => ({
    params: { slug: episode.slug },
    props: { episode, newer: list[i - 1] ?? null, older: list[i + 1] ?? null, all: list },
  }));
}

const { episode: e, newer, older, all } = Astro.props as {
  episode: Episode;
  newer: Episode | null;
  older: Episode | null;
  all: Episode[];
};
const cast = e.characters.filter((c) => Object.hasOwn(characters, c)) as CharacterId[];
const summary = episodeSummary(e);
const description = episodeDescription(e);

// Related episodes: same cat first (the first cat in the cast, Nora last), topped up with the newest others.
const main = cast.find((c) => c !== 'nora') ?? cast[0];
const neighbours = new Set([e.slug, newer?.slug, older?.slug]);
const sameCat = main ? all.filter((x) => !neighbours.has(x.slug) && x.characters.includes(main)) : [];
const related = [...sameCat, ...all.filter((x) => !neighbours.has(x.slug) && !sameCat.includes(x))].slice(0, 4);
const relatedTitle = main && sameCat.length ? `${t('seo.moreWith')} ${characters[main].name}` : t('seo.moreEpisodes');

const video = videoLd(e);
const jsonLd = [
  breadcrumbLd([
    { name: t('seo.home'), path: '/' },
    { name: t('episodes.pageTitle'), path: '/episodes' },
    { name: e.title, path: `/episodes/${e.slug}` },
  ]),
  ...(video ? [video] : []),
];
---

<Base
  title={episodeTitle(e.title)}
  description={description}
  path={`/episodes/${e.slug}`}
  ogImage={e.thumbnailUrl || undefined}
  ogImageAlt={`${t('episodes.thumbAlt')} ${e.title}`}
  ogType={video ? 'video.other' : 'website'}
  {jsonLd}
>
  <div class="container page">
    <p class="back"><a href="/episodes">{t('episodes.all')}</a></p>
    <div class="layout">
      <div class="player"><EpisodeCard episode={e} size="mini" eager /></div>
      <div class="info">
        <h1>{e.title}</h1>
        {summary && <p class="lede">{summary}</p>}
        {cast.length > 0 && (
          <>
            <h2 class="cast-label">{t('seo.meetCast')}</h2>
            <ul class="cast">
              {cast.map((c) => (
                <li>
                  <a href={`/cats/${c}`} style={`--accent:${characters[c].color}`}>
                    <img src={characters[c].face} width="40" height="40" alt="" loading="lazy" />
                    <span class="who">
                      <span class="name">{characters[c].name}</span>{' '}
                      <span class="nick">{characters[c].nickname}</span>
                    </span>
                  </a>
                  <p class="one">{characters[c].oneLiner}</p>
                </li>
              ))}
            </ul>
          </>
        )}
        <a class="btn btn-lg" href="/tango-me">{t('player.cta')}</a>
      </div>
    </div>
    <nav class="pn" aria-label={t('episodes.all')}>
      {older ? <a class="prev" href={`/episodes/${older.slug}`}><span>{t('episodes.prev')}</span>{' '}{older.title}</a> : <span />}
      {newer ? <a class="next" href={`/episodes/${newer.slug}`}><span>{t('episodes.next')}</span>{' '}{newer.title}</a> : <span />}
    </nav>
    {related.length > 0 && (
      <section class="related">
        <h2>{relatedTitle}</h2>
        <EpisodeGrid episodes={related} filters={false} />
      </section>
    )}
  </div>
</Base>

<style>
  .back {
    margin: 0 0 var(--space-3);
    font-weight: 600;
  }
  .layout {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }
  @media (min-width: 52rem) {
    .layout {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      gap: var(--space-5);
    }
  }
  .player {
    inline-size: min(100%, 22rem);
    margin-inline: auto;
  }
  .player :global(.play) {
    inline-size: 52px !important;
    block-size: 52px !important;
    inset-inline-start: 1rem !important;
    inset-block-end: 1rem !important;
  }
  .player :global(.play svg) {
    inline-size: 20px;
    block-size: 20px;
  }
  .lede {
    margin-block: 0 var(--space-3);
  }
  .cast-label {
    margin: 0 0 var(--space-1);
    font: 400 1rem var(--font-body);
    color: var(--c-paper-2);
  }
  .cast {
    display: grid;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }
  .cast a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.25rem 1rem 0.25rem 0.25rem;
    border-radius: var(--radius-pill);
    background: rgb(244 233 216 / 9%);
    font-weight: 600;
    text-decoration: none;
  }
  .cast img {
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--accent);
  }
  .cast .nick {
    font-weight: 400;
    color: var(--c-paper-2);
  }
  .cast .one {
    margin: 0.35rem 0 0 0.25rem;
    font-size: 0.95rem;
    color: var(--c-paper-2);
  }
  .related {
    margin-block-start: var(--space-5);
  }
  .related h2 {
    margin-block-end: var(--space-3);
  }
  .pn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
    margin-block-start: var(--space-5);
    padding-block-start: var(--space-3);
    border-block-start: 1px solid rgb(244 233 216 / 12%);
  }
  .pn a {
    display: grid;
    gap: 0.2rem;
    font: 600 1.1rem var(--font-display);
    text-decoration: none;
  }
  .pn span {
    font: 400 0.9rem var(--font-body);
    color: var(--c-paper-2);
  }
  .next {
    text-align: end;
  }
</style>
