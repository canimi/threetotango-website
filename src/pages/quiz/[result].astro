---
import Base from '../../layouts/Base.astro';
import { characters } from '../../data/characters';
import { quizCats, type QuizCat } from '../../data/quiz';
import { t } from '../../i18n/t';

export function getStaticPaths() {
  return quizCats.map((result) => ({ params: { result } }));
}

const id = Astro.params.result as QuizCat;
const c = characters[id];
const lines = [1, 2, 3].map((n) => t(`quiz.results.${id}.line${n}`));
const verdict = `${t('quiz.youAre')} ${c.name}.`;
const path = `/quiz/${id}`;
const shareUrl = new URL(path, Astro.site ?? 'https://threetotango.canimi.app').href;
const personality = { luka: 'genius', budy: 'chatterbox', caddy: 'unbothered' }[id];
---

<Base
  title={`${verdict} ${c.nickname} | ${t('brand.name')}`}
  description={lines[0]}
  path={path}
  ogImage={c.portrait}
>
  <div class="container wrap" style={`--accent:${c.color};--pos:${c.portraitPos};--zoom:${c.portraitZoom}`}>
    <p class="kicker">{t('quiz.title')}</p>
    <h1>{verdict}</h1>
    <p class="nick">{c.nickname}</p>
    <div class="portrait">
      <img src={c.full} width="600" height="800" alt={`${t('cats.portraitAlt')} ${c.name}`} />
    </div>
    <ul class="lines">{lines.map((l) => <li>{l}</li>)}</ul>

    <a class="btn btn-lg cta" href={`/tango-me?personality=${personality}`}>{t('quiz.bridge').replace('{name}', c.name)}</a>
    <p class="bridge-sub">{t('quiz.bridgeSub')}</p>
    <p class="hint">{t('quiz.shareHint')}</p>

    <div class="actions" data-share data-url={shareUrl} data-text={`${t('quiz.shareText')} ${c.name}.`} data-copied={t('quiz.copied')}>
      <button type="button" class="btn btn-ghost" data-copy>{t('quiz.copyLink')}</button>
      <button type="button" class="btn btn-ghost" data-native hidden>{t('quiz.share')}</button>
    </div>
    <p class="status" role="status" data-status></p>

    <p class="retake"><a href="/quiz">{t('quiz.retake')}</a></p>
  </div>
</Base>

<script>
  const box = document.querySelector<HTMLElement>('[data-share]');
  if (box) {
    const { url = '', text = '', copied = '' } = box.dataset;
    const status = document.querySelector<HTMLElement>('[data-status]')!;
    box.querySelector('[data-copy]')!.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        status.textContent = copied;
      } catch {
        window.prompt('', url);
      }
    });
    const native = box.querySelector<HTMLElement>('[data-native]')!;
    if (typeof navigator.share === 'function') {
      native.hidden = false;
      native.addEventListener('click', () => {
        navigator.share({ title: document.title, text, url }).catch(() => {});
      });
    }
  }
</script>

<style>
  .bridge-sub {
    margin: 0.6rem 0 0;
    color: var(--c-paper-2);
    font-size: 0.95rem;
  }
  .wrap {
    padding-block: var(--space-4) var(--space-5);
    text-align: center;
  }
  .kicker {
    margin: 0;
    color: var(--c-paper-2);
    font-weight: 600;
  }
  h1 {
    font-size: clamp(2.8rem, 2rem + 4vw, 4.8rem);
    margin-block: var(--space-1) 0;
  }
  .nick {
    margin: 0 0 var(--space-4);
    font: 600 1.4rem var(--font-display);
    color: var(--accent);
  }
  .portrait {
    margin-inline: auto;
    inline-size: min(70%, 18rem);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 999px 999px 26px 26px;
    background: var(--c-caddy);
    box-shadow: 0 0 0 8px var(--c-wall), 0 0 0 11px var(--accent), 0 40px 70px -30px rgb(var(--c-shadow) / 90%);
  }
  .portrait img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .lines {
    list-style: none;
    padding: 0;
    max-inline-size: 34rem;
    margin-inline: auto;
    margin-block: var(--space-4);
    font-size: 1.15rem;
  }
  .lines li {
    margin-block-end: var(--space-2);
  }
  .hint {
    color: var(--c-paper-2);
    max-inline-size: 30rem;
    margin-inline: auto;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    justify-content: center;
  }
  .status {
    min-block-size: 1.5rem;
    color: var(--c-paper-2);
  }
  .retake {
    font-weight: 600;
  }
  [hidden] {
    display: none !important;
  }
</style>
