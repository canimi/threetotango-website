---
import Base from '../../layouts/Base.astro';
import EpisodeGrid from '../../components/EpisodeGrid.astro';
import { characters, characterIds } from '../../data/characters';
import { filterByCharacter, type CharacterId } from '../../lib/episodes';
import { getEpisodes } from '../../lib/site-episodes';
import { t } from '../../i18n/t';

export function getStaticPaths() {
  return characterIds.map((slug) => ({ params: { slug } }));
}

const id = Astro.params.slug as CharacterId;
const c = characters[id];
const list = filterByCharacter(await getEpisodes(), id);
---

<Base
  title={`${c.name}, ${c.nickname} | ${t('brand.name')}`}
  description={c.oneLiner}
  path={`/cats/${id}`}
  ogImage={c.portrait}
>
  <div class="container wrap" style={`--accent:${c.color}`}>
    <p><a href="/cats">&larr; {t('cats.back')}</a></p>
    <div class="top">
      <img src={c.portrait} width="480" height="480" alt={`${t('cats.portraitAlt')} ${c.name}`} />
      <div>
        <h1>{c.name}</h1>
        <p class="nick">{c.nickname}</p>
        <p>{c.oneLiner}</p>
        <h2>{t('cats.loves')}</h2>
        <ul>{c.loves.map((x) => <li>{x}</li>)}</ul>
        <h2>{t('cats.hates')}</h2>
        <ul>{c.hates.map((x) => <li>{x}</li>)}</ul>
        <a class="btn" href="/tango-me">{t('cta.tangoFree')}</a>
      </div>
    </div>
    <h2>{t('cats.episodesWith')} {c.name}</h2>
    {list.length ? <EpisodeGrid episodes={list} /> : <p>{t('cats.noEpisodes')}</p>}
  </div>
</Base>

<style>
  .wrap {
    padding-block: var(--space-4);
  }
  .top {
    display: grid;
    gap: var(--space-4);
    margin-block-end: var(--space-4);
  }
  @media (min-width: 52rem) {
    .top {
      grid-template-columns: 1fr 1.2fr;
      align-items: start;
    }
  }
  img {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-card);
    border-block-start: 10px solid var(--accent);
    background: var(--c-caddy);
  }
  .nick {
    font-weight: 600;
    color: var(--c-ink-2);
    margin-block-start: 0;
  }
  h2 {
    font-size: 1.2rem;
    margin-block: var(--space-2) 0;
  }
</style>
