---
import Base from '../layouts/Base.astro';
import TangoMe from '../components/TangoMe.astro';
import { t } from '../i18n/t';
---

<Base title={`${t('tango.pageTitle')} | ${t('brand.name')}`} description={t('tango.pageDesc')} path="/tango-me">
  <section class="container tm">
    <h1>{t('tango.title')}</h1>
    <p class="sub">{t('tango.sub')}</p>

    <TangoMe />
    <p class="fine">{t('tango.disclosure')}</p>
  </section>
</Base>

<style>
  .tm {
    padding-block: var(--space-4);
  }
  h1,
  .sub {
    text-align: center;
  }
  .sub {
    color: var(--c-ink-2);
    margin-block: 0 var(--space-3);
  }
  .fine {
    text-align: center;
    color: var(--c-ink-2);
    font-size: 0.9rem;
    margin-block-start: var(--space-3);
  }
</style>
