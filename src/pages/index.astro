---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CharacterCard from '../components/CharacterCard.astro';
import EpisodeGrid from '../components/EpisodeGrid.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { characterIds } from '../data/characters';
import { latestWithHero } from '../lib/episodes';
import { getEpisodes, basename } from '../lib/site-episodes';
import { t } from '../i18n/t';

const episodes = await getEpisodes();
const hero = latestWithHero(episodes);
const latest = episodes[0];
const recent = episodes.slice(0, 8);
const latestHref = latest ? `/episodes/${latest.slug}` : '/episodes';
---

<Base title={`${t('brand.name')}: ${t('brand.promise')}`} description={t('brand.promise')} path="/">
  <Hero latest={latest ?? null} {hero} heroFile={hero?.heroMp4Path ? basename(hero.heroMp4Path) : null} {latestHref} />

  <section class="container block" id="episodes">
    <h2>{t('episodes.title')}</h2>
    <EpisodeGrid episodes={recent} filters={false} />
    <p class="center"><a class="btn" href="/episodes">{t('episodes.seeAll')}</a></p>
  </section>

  <section class="container block" id="household">
    <h2>{t('household.title')}</h2>
    <p class="sub">{t('household.sub')}</p>
    <div class="cards">
      {characterIds.map((id) => <CharacterCard id={id} />)}
    </div>
  </section>

  <section class="band">
    <div class="container band-in">
      <div>
        <h2>{t('showcase.bandTitle')}</h2>
        <p>{t('showcase.sub')}</p>
      </div>
      <a class="btn" href="/tango-me">{t('common.tryFree')}</a>
    </div>
  </section>

  <section class="quiz">
    <div class="container block">
      <h2>{t('quizTeaser.title')}</h2>
      <p class="sub">{t('quizTeaser.sub')}</p>
      <a class="btn" href="/quiz">{t('quizTeaser.cta')}</a>
    </div>
  </section>

  <section class="container block newsletter">
    <h2>{t('newsletter.title')}</h2>
    <p class="lead">{t('newsletter.sub')}</p>
    <p class="sub">{t('newsletter.body')}</p>
    <SubscribeForm source="footer" />
    <p class="gift-link"><a href="/gift">{t('newsletter.seeGift')}</a></p>
  </section>

  <section class="container block bts">
    <h2>{t('bts.teaserTitle')}</h2>
    <p class="sub">{t('bts.teaserSub')}</p>
    <a class="btn" href="/behind-the-scenes">{t('bts.teaserCta')}</a>
  </section>

  <section class="container block final">
    <h2>{t('finalCta.title')}</h2>
    <p class="sub">{t('finalCta.sub')}</p>
    <a class="btn" href="/tango-me">{t('cta.tangoFree')}</a>
  </section>
</Base>

<style>
  .block {
    padding-block: var(--space-4);
  }
  .sub {
    color: var(--c-ink-2);
    margin-block: 0 var(--space-3);
  }
  .lead {
    font-family: var(--font-display);
    font-size: 1.4rem;
    margin-block: 0 var(--space-1);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-3);
  }
  .quiz {
    background: var(--c-caddy);
    text-align: center;
  }
  .band {
    background: var(--c-mustard);
    color: var(--c-ink);
  }
  .band-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-3);
  }
  .band h2,
  .band p {
    margin-block: 0 var(--space-1);
  }
  .band .btn {
    background: var(--c-cream);
    border: 3px solid var(--c-ink);
  }
  .center {
    text-align: center;
    margin-block-start: var(--space-3);
  }
  .gift-link {
    margin-block-start: var(--space-2);
  }
  .final,
  .newsletter {
    text-align: center;
  }
</style>
