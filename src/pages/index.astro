---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import EpisodeGrid from '../components/EpisodeGrid.astro';
import TangoShowcase from '../components/TangoShowcase.astro';
import CatOfWeek from '../components/CatOfWeek.astro';
import CastPicker from '../components/CastPicker.astro';
import QuizTeaser from '../components/QuizTeaser.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import Marquee from '../components/Marquee.astro';
import { getEpisodes } from '../lib/site-episodes';
import { t } from '../i18n/t';

const episodes = await getEpisodes();
const recent = episodes.slice(0, 12);
---

<Base title={`${t('brand.name')}: ${t('brand.promise')}`} description={t('brand.promise')} path="/">
  <Hero {episodes} />

  <section class="container block" id="episodes" aria-labelledby="episodes-title">
    <div class="head">
      <h2 id="episodes-title">{t('episodes.title')}</h2>
      <p class="lede">{t('episodes.sub')}</p>
    </div>
    <EpisodeGrid episodes={recent} layout="rail" />
    <p class="all"><a href="/episodes">{t('episodes.seeAll')}</a></p>
  </section>

  <Marquee set="a" tone="mustard" tilt={-1.5} />
  <TangoShowcase />
  <CatOfWeek />

  <section class="container block" id="household" aria-labelledby="household-title">
    <div class="head">
      <h2 id="household-title">{t('household.title')}</h2>
      <p class="lede">{t('household.sub')}</p>
    </div>
    <CastPicker {episodes} />
  </section>

  <Marquee set="b" tone="rug" tilt={1.2} />
  <QuizTeaser />

  <section class="container newsletter" aria-labelledby="news-title">
    <div class="news-copy">
      <h2 id="news-title">{t('newsletter.title')}</h2>
      <p class="lede">{t('newsletter.sub')}</p>
      <p class="gift-link"><a href="/gift">{t('newsletter.seeGift')}</a></p>
    </div>
    <SubscribeForm source="footer" />
  </section>
</Base>

<style>
  .block {
    padding-block: var(--space-5) 0;
  }
  #episodes {
    padding-block-start: var(--space-3);
  }
  .head {
    margin-block-end: var(--space-3);
  }
  .head .lede {
    margin: 0;
  }
  #household {
    padding-block-end: var(--space-2);
  }
  #household .head {
    text-align: center;
  }
  #household .head .lede {
    margin-inline: auto;
  }
  .all {
    margin: var(--space-2) 0 var(--space-5);
    font-weight: 600;
    font-size: 1.1rem;
  }
  .newsletter {
    display: grid;
    gap: var(--space-3) var(--space-5);
    align-items: center;
    padding-block: var(--space-4) var(--space-5);
  }
  @media (min-width: 56rem) {
    .newsletter {
      grid-template-columns: 1fr 1fr;
    }
  }
  .newsletter h2 {
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.1rem);
  }
  .news-copy .lede {
    margin-block: 0 var(--space-1);
  }
  .gift-link {
    margin: 0;
    font-weight: 600;
  }
</style>
