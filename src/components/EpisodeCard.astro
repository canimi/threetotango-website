---
import type { Episode } from '../lib/episodes';
import { characters } from '../data/characters';
import { playerData, isNew } from '../lib/player';
import { t } from '../i18n/t';

interface Props {
  episode: Episode;
  /** Thumbnail loading strategy. */
  eager?: boolean;
  size?: 'rail' | 'grid' | 'mini';
}
const { episode: e, eager = false, size = 'grid' } = Astro.props;
const known = e.characters.filter((c) => Object.hasOwn(characters, c));
const accent = known[0] ? characters[known[0]].color : 'var(--c-mustard)';
const hasThumb = Boolean(e.thumbnailUrl);
const fresh = isNew(e.publishedAt);
---

<article class:list={['ep', `ep-${size}`]} data-characters={known.join(' ')}>
  <a
    class="thumb"
    href={`/episodes/${e.slug}`}
    {...playerData(e, known)}
    aria-label={`${t('common.playEpisode')}: ${e.title}`}
    data-tilt
  >
    {
      hasThumb ? (
        <img
          src={e.thumbnailUrl}
          width="360"
          height="640"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          alt={`${t('episodes.thumbAlt')} ${e.title}`}
        />
      ) : (
        <span class="ph" style={`--accent:${accent}`}>
          <span class="ph-title">{e.title}</span>
        </span>
      )
    }
    <span class="glare" aria-hidden="true"></span>
    {fresh && <span class="badge">{t('common.newBadge')}</span>}
    <span class="play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="14" height="14"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
    </span>
  </a>
  {size !== 'mini' && (
    <h3><a href={`/episodes/${e.slug}`}>{e.title}</a></h3>
  )}
</article>

<style>
  .ep {
    position: relative;
    min-inline-size: 0;
  }
  /* Scrapbook: a strip of mustard tape holds each rail card to the wall. */
  .ep-rail::before {
    content: '';
    position: absolute;
    z-index: 3;
    inset-block-start: -0.55rem;
    inset-inline-start: 50%;
    inline-size: 3.6rem;
    block-size: 1.15rem;
    background: rgb(255 207 110 / 72%);
    box-shadow: 0 1px 2px rgb(0 0 0 / 20%);
    transform: translateX(-50%) rotate(-4deg);
    pointer-events: none;
  }
  .ep-rail:nth-child(even)::before {
    transform: translateX(-50%) rotate(3.5deg);
  }
  .thumb {
    position: relative;
    display: block;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-thumb);
    overflow: hidden;
    background: var(--c-wall-2);
    isolation: isolate;
  }
  /* Pointer tilt (vars written by pointer-fx on fine pointers only). */
  .thumb {
    transform: perspective(800px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  :global(.is-tilting).thumb {
    transition-duration: 0.08s;
  }
  .glare {
    position: absolute;
    z-index: 1;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .glare::before {
    content: '';
    position: absolute;
    inset-block-start: -60%;
    left: -60%;
    inline-size: 120%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(255 232 190 / 32%), rgb(255 207 110 / 8%) 55%, transparent);
    transform: translate(var(--gx, 50%), var(--gy, 50%));
  }
  :global(.is-tilting).thumb .glare {
    opacity: 1;
  }
  .thumb::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(10 26 21 / 55%), transparent 38%);
    pointer-events: none;
  }
  .thumb img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .thumb:hover img {
    transform: scale(1.04);
  }
  .play {
    position: absolute;
    z-index: 1;
    inset-inline-start: 0.65rem;
    inset-block-end: 0.65rem;
    display: grid;
    place-items: center;
    inline-size: 36px;
    block-size: 36px;
    border-radius: 50%;
    background: var(--c-mustard);
    color: var(--c-on-mustard);
    box-shadow: 0 4px 12px -2px rgb(var(--c-shadow) / 60%);
    transition: transform 0.15s ease;
  }
  .play svg {
    margin-inline-start: 2px;
  }
  .thumb:hover .play,
  .thumb:focus-visible .play {
    transform: scale(1.12);
  }
  .ep-mini .play {
    inline-size: 28px;
    block-size: 28px;
    inset-inline-start: 0.4rem;
    inset-block-end: 0.4rem;
  }
  .badge {
    position: absolute;
    z-index: 1;
    inset-block-start: 0.6rem;
    inset-inline-start: 0.6rem;
    padding: 0.1rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--c-rug);
    color: var(--c-paper);
    font: 600 0.85rem var(--font-display);
  }
  .ep-mini .badge {
    display: none;
  }
  .ph {
    display: grid;
    place-items: center;
    inline-size: 100%;
    block-size: 100%;
    padding: var(--space-2);
    background:
      radial-gradient(circle at 50% 35%, color-mix(in srgb, var(--accent) 35%, transparent), transparent 65%),
      var(--c-wall-2);
    color: var(--c-paper);
    font: 600 1.15rem var(--font-display);
    text-align: center;
  }
  h3 {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    margin: 0.7rem 0 0;
    font-size: 1.05rem;
    line-height: 1.25;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--c-lamp);
  }
</style>
