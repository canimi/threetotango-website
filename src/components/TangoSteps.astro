---
/** "How to tango (with three cats)": numbered paw prints laid out like a dance-step diagram. */
import { t } from '../i18n/t';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const paw = (x: number, y: number, r: number, c: string) =>
  `<g transform="translate(${x} ${y}) rotate(${r})" fill="${c}"><ellipse cx="0" cy="8" rx="15" ry="12"/><ellipse cx="-16" cy="-8" rx="6" ry="8"/><ellipse cx="-6" cy="-16" rx="6" ry="8"/><ellipse cx="6" cy="-16" rx="6" ry="8"/><ellipse cx="16" cy="-8" rx="6" ry="8"/></g>`;
const L = '#8a9bb0';
const B = '#e07b39';
const C = '#c9b99e';
const svg = `<svg viewBox="0 0 600 230" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="${t('tangoSteps.title')}">
<path d="M50 176 Q80 100 140 104 T240 166" fill="none" stroke="${L}" stroke-width="2.5" stroke-dasharray="6 7"/>
<path d="M310 76 Q370 170 410 150 T495 64" fill="none" stroke="${B}" stroke-width="2.5" stroke-dasharray="6 7"/>
${paw(50, 180, -20, L)}${paw(140, 100, 25, L)}${paw(240, 170, 60, L)}
${paw(310, 70, 150, B)}${paw(410, 152, 60, B)}${paw(495, 60, -10, B)}${paw(555, 196, 0, C)}
<g font-family="Fredoka, system-ui, sans-serif" font-weight="600" font-size="17" fill="currentColor">
<text x="74" y="214">1</text><text x="166" y="132">2</text><text x="266" y="204">3</text>
<text x="334" y="108">1</text><text x="436" y="186">2</text><text x="522" y="92">3</text></g></svg>`;
---

<figure class:list={["tango-steps", { compact }]}>
  <figcaption class="serif">{t('tangoSteps.title')}</figcaption>
  <div class="diagram" set:html={svg} />
  <ul class="legend">
    <li class="l">{t('tangoSteps.luka')}</li>
    <li class="b">{t('tangoSteps.budy')}</li>
    <li class="c">{t('tangoSteps.caddy')}</li>
  </ul>
</figure>

<style>
  .tango-steps {
    margin: var(--space-4) auto;
    max-inline-size: 44rem;
    padding: 1.4rem clamp(1rem, 4vw, 2rem);
    border-radius: 12px;
    background: var(--c-paper);
    color: var(--c-ink);
    box-shadow: 0 30px 60px -30px rgb(var(--c-shadow) / 90%);
  }
  figcaption {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.6rem);
  }
  .diagram :global(svg) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    margin-block: 0.4rem;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 600 0.72rem / 1.3 var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .l { color: #56667c; }
  .b { color: #9c4a14; }
  .c { color: var(--c-ink-2); }
  @media (prefers-reduced-motion: no-preference) {
    .diagram :global(g[transform]) {
      animation: step 0.4s cubic-bezier(0.3, 1.6, 0.5, 1) both;
      animation-timeline: view();
      animation-range: entry 10% cover 35%;
    }
  }
  @keyframes step {
    from {
      opacity: 0;
    }
  }
  .compact {
    margin-block: var(--space-3);
  }
</style>
