---
import { t } from '../i18n/t';
import type { Episode } from '../lib/episodes';
import { characters, characterIds } from '../data/characters';
import { playerData } from '../lib/player';
import { basename } from '../lib/site-episodes';
import CastLineup from './CastLineup.astro';

interface Props {
  episodes: Episode[];
}
const { episodes } = Astro.props;

// The frame plays the newest episode that has a hero mp4, else shows the newest thumbnail.
const hero = episodes.find((e) => e.heroMp4Path) ?? null;
const shown = hero ?? episodes[0] ?? null;
const heroSrc = hero?.heroMp4Path ? `/media/hero/${basename(hero.heroMp4Path)}` : null;
const known = (e: Episode) => e.characters.filter((c) => Object.hasOwn(characters, c));

// Wall tiles: real thumbnails, repeated to fill; cast crops if the feed has none.
const thumbs = [...new Set(episodes.map((e) => e.thumbnailUrl).filter(Boolean))];
const tiles = thumbs.length ? thumbs : characterIds.map((id) => characters[id].full);
const COLS = 6;
const perCol = Math.max(4, Math.ceil(tiles.length / COLS));
const columns = Array.from({ length: COLS }, (_, c) =>
  Array.from({ length: perCol }, (_, i) => tiles[(c * 2 + i) % tiles.length]),
);
const EAGER = 12;
---

<section class="hero" data-hero>
  <svg class="fx-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <filter id="wall-ripple" x="-5%" y="-5%" width="110%" height="110%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.006 0.011" numOctaves="1" seed="7" result="noise" data-ripple-noise
      ></feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" data-ripple-map
      ></feDisplacementMap>
    </filter>
  </svg>
  <div class="wall" aria-hidden="true" data-wall>
    {
      columns.map((col, c) => (
        <div class:list={['col', { rev: c % 2 === 1 }]} style={`--dur:${70 + c * 9}s`}>
          {[0, 1].map((copy) => (
            <div class="set">
              {col.map((src, i) => (
                <img
                  src={src}
                  width="270"
                  height="480"
                  alt=""
                  decoding="async"
                  loading={copy === 0 && c * perCol + i < EAGER ? 'eager' : 'lazy'}
                  fetchpriority="low"
                />
              ))}
            </div>
          ))}
        </div>
      ))
    }
  </div>
  <div class="veil" aria-hidden="true"></div>

  <div class="container grid">
    <div class="copy">
      <h1 class="sr-only">{t('hero.h1')}</h1>
      <CastLineup />
      <div class="pitch">
        <p class="line">{t('hero.line')}</p>
        <a class="btn btn-lg" href="/tango-me" data-magnetic>{t('cta.tangoFreeLong')}</a>
      </div>
    </div>

    {
      shown && (
        <figure class="frame-wrap">
          <a
            class="frame"
            href={`/episodes/${shown.slug}`}
            {...playerData(shown, known(shown))}
            aria-label={`${t('hero.frameLabel')}: ${shown.title}`}
          >
            {heroSrc ? (
              <video
                data-hero-video
                muted
                loop
                playsinline
                preload="none"
                poster={shown.thumbnailUrl || undefined}
                width="360"
                height="640"
                aria-label={t('hero.videoLabel')}
              >
                <source data-src={heroSrc} type="video/mp4" />
              </video>
            ) : shown.thumbnailUrl ? (
              <img src={shown.thumbnailUrl} width="360" height="640" alt={`${t('episodes.thumbAlt')} ${shown.title}`} />
            ) : (
              <img src={characters.nora.full} width="600" height="800" alt={`${t('cats.portraitAlt')} Nora`} />
            )}
            <span class="play" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
            </span>
          </a>
          {heroSrc && (
            <button
              type="button"
              class="sound"
              data-sound
              aria-pressed="false"
              data-on={t('common.soundOn')}
              data-off={t('common.soundOff')}
              data-play={t('common.playPreview')}
            >
              {t('common.soundOn')}
            </button>
          )}
          <figcaption>{shown.title}</figcaption>
        </figure>
      )
    }
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const btn = document.querySelector<HTMLButtonElement>('[data-sound]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // The preview video is not part of first paint: its source is attached after the page has
  // loaded, so it never competes with fonts and images on a slow phone connection.
  let visible = true;
  const attach = () => {
    const src = v?.querySelector<HTMLSourceElement>('source[data-src]');
    if (!v || !src) return;
    src.src = src.dataset.src ?? '';
    src.removeAttribute('data-src');
    v.load();
  };
  if (v) {
    const start = () => {
      attach();
      if (!reduce && visible) void v.play().catch(() => {});
    };
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  }

  if (v && btn) {
    if (reduce) btn.textContent = btn.dataset.play ?? '';
    btn.addEventListener('click', () => {
      attach();
      if (v.paused) {
        v.muted = false;
        void v.play();
      } else {
        v.muted = !v.muted;
      }
      btn.setAttribute('aria-pressed', String(!v.muted));
      btn.textContent = (v.muted ? btn.dataset.on : btn.dataset.off) ?? '';
    });
  }

  // Pause the drifting wall (and the muted preview) while the hero is off screen.
  if (hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => {
      hero.classList.toggle('offscreen', !e.isIntersecting);
      visible = e.isIntersecting;
      if (v && v.muted && !reduce && !v.querySelector('source[data-src]')) {
        if (e.isIntersecting) void v.play().catch(() => {});
        else v.pause();
      }
    }).observe(hero);
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-block-size: clamp(36rem, 100svh, 64rem);
    margin-block-start: calc(var(--header-h) * -1);
    padding-block: calc(var(--header-h) + var(--space-4)) var(--space-5);
    overflow: clip;
    isolation: isolate;
    background: var(--c-wall);
  }
  /* Smooth fade into the page colour. */
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    block-size: 28%;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(to bottom, rgb(23 50 42 / 0%), rgb(23 50 42 / 80%) 55%, var(--c-wall) 88%);
  }
  .wall {
    position: absolute;
    inset: -4rem -2rem;
    z-index: -2;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 14px;
    transform: rotate(-4deg) scale(1.08);
    /* The wall itself fades out well above the hero's bottom edge, so no tile pixel can ever reach
       the last (fractional) device-pixel row and show as a dashed line on Android/high-DPR screens.
       The wall overhangs the hero by 4rem; the extra 9rem covers the -4deg tilt at the corners. */
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 4rem - 22rem), transparent calc(100% - 4rem - 12rem));
    mask-image: linear-gradient(to bottom, #000 calc(100% - 4rem - 22rem), transparent calc(100% - 4rem - 12rem));
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    will-change: transform;
    backface-visibility: hidden;
  }
  .set {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .wall img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    border-radius: var(--radius-thumb);
    background: var(--c-wall-2);
  }
  .veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgb(23 50 42 / 55%), rgb(23 50 42 / 20%) 30%, rgb(23 50 42 / 30%) 70%, var(--c-wall) 98%),
      linear-gradient(100deg, rgb(23 50 42 / 96%) 0%, rgb(23 50 42 / 88%) 40%, rgb(23 50 42 / 45%) 75%, rgb(23 50 42 / 55%) 100%);
  }
  .grid {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-5);
    }
  }
  .copy {
    min-inline-size: 0;
  }
  .pitch {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    margin-block-start: var(--space-4);
  }
  .line {
    max-inline-size: 34ch;
    margin: 0;
    color: var(--c-paper);
    font: 600 clamp(1.25rem, 1rem + 0.8vw, 1.85rem) / 1.25 var(--font-display);
    text-shadow: 0 2px 20px rgb(var(--c-shadow) / 70%);
  }
  .fx-defs {
    position: absolute;
    inline-size: 0;
    block-size: 0;
  }
  /* Ripple is attached by pointer-fx only while the pointer moves. */
  .wall.is-rippling {
    filter: url(#wall-ripple);
  }
  .frame-wrap {
    position: relative;
    margin: 0;
    justify-self: center;
    inline-size: clamp(15rem, 4rem + 15vw, 25rem);
  }
  .frame {
    position: relative;
    display: block;
    aspect-ratio: 9 / 16;
    border-radius: 30px;
    overflow: hidden;
    background: var(--c-wall-2);
    box-shadow:
      0 0 0 6px var(--c-paper),
      0 40px 80px -24px rgb(var(--c-shadow) / 95%),
      0 0 120px -10px rgb(255 207 110 / 35%);
    transform: rotate(-3deg);
    transition: transform 0.25s ease;
  }
  .frame:hover {
    transform: rotate(-1.5deg) scale(1.015);
  }
  .frame video,
  .frame img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .play {
    position: absolute;
    inset-inline-start: 0.9rem;
    inset-block-end: 0.9rem;
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    border-radius: 50%;
    background: var(--c-mustard);
    color: var(--c-on-mustard);
  }
  .play svg {
    margin-inline-start: 2px;
  }
  .sound {
    position: absolute;
    inset-inline-end: -0.75rem;
    inset-block-start: 1.5rem;
    min-block-size: 2.5rem;
    padding-inline: 1rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--c-paper);
    color: var(--c-ink);
    font: 600 0.95rem var(--font-display);
    cursor: pointer;
    box-shadow: 0 10px 24px -8px rgb(var(--c-shadow) / 80%);
    transform: rotate(3deg);
  }
  .sound[aria-pressed='true'] {
    background: var(--c-lamp);
  }
  figcaption {
    margin-block-start: var(--space-3);
    text-align: center;
    font: 600 1.15rem var(--font-display);
    color: var(--c-paper);
  }

  /* One orchestrated entrance, then only the slow drift. */
  @media (prefers-reduced-motion: no-preference) {
    .col {
      animation: drift var(--dur) linear infinite;
    }
    .col.rev {
      animation-direction: reverse;
    }
    .offscreen .col {
      animation-play-state: paused;
    }
    .wall {
      animation: wall-in 0.5s ease-out both;
    }
    .copy :global([data-lineup]) {
      animation: rise 0.55s 0.12s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
    .pitch {
      animation: rise 0.55s 0.25s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
    .frame-wrap {
      animation: drop 0.6s 0.3s cubic-bezier(0.3, 1.5, 0.5, 1) both;
    }
  }
  @keyframes drift {
    to {
      transform: translateY(calc(-50% - 7px));
    }
  }
  @keyframes wall-in {
    from {
      opacity: 0;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-40px) rotate(4deg);
    }
  }

  @media (max-width: 63.99rem) {
    .hero {
      min-block-size: 0;
      align-items: start;
      padding-block: calc(var(--header-h) + var(--space-3)) var(--space-4);
    }
    .wall {
      grid-template-columns: repeat(3, 1fr);
    }
    .wall .col:nth-child(n + 4) {
      display: none;
    }
    .veil {
      background:
        linear-gradient(to bottom, rgb(23 50 42 / 50%), rgb(23 50 42 / 35%) 30%, rgb(23 50 42 / 92%) 52%, var(--c-wall) 100%);
    }
    .frame-wrap {
      order: -1;
      inline-size: min(36vw, 12rem);
    }
    .play {
      inline-size: 36px;
      block-size: 36px;
      inset-inline-start: 0.6rem;
      inset-block-end: 0.6rem;
    }
    .grid {
      gap: var(--space-3);
    }
    figcaption {
      display: none;
    }
    .sound {
      inset-inline-end: -1.5rem;
    }
    .pitch {
      justify-items: center;
      text-align: center;
    }
    .pitch {
      margin-block-start: var(--space-2);
      gap: var(--space-2);
    }
    .line {
      font-size: 1.2rem;
    }
  }
  @media (max-width: 47.99rem) {
    .pitch {
      justify-items: stretch;
      text-align: start;
    }
  }
</style>
