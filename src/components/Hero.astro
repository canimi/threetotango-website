---
import { t } from '../i18n/t';
import type { Episode } from '../lib/episodes';
import { characters } from '../data/characters';
import { playerData } from '../lib/player';
import { basename } from '../lib/site-episodes';
import CastLineup from './CastLineup.astro';

interface Props {
  episodes: Episode[];
}
const { episodes } = Astro.props;

// The frame plays the newest episode that has a hero mp4, else shows the newest thumbnail.
const hero = episodes.find((e) => e.heroMp4Path) ?? null;
const shown = hero ?? episodes[0] ?? null;
const heroSrc = hero?.heroMp4Path ? `/media/hero/${basename(hero.heroMp4Path)}` : null;
const known = (e: Episode) => e.characters.filter((c) => Object.hasOwn(characters, c));

// The slogan is set visibly; the brand prefix stays for search engines and screen readers.
const [sloganA, rest] = t('hero.slogan').split('{em}');
const [sloganEm, sloganB] = rest.split('{/em}');
---

<section class="hero" data-hero>
  <div class="room" aria-hidden="true"></div>

  <div class="container grid">
    <div class="copy">
      <p class="kicker">{t('hero.kicker')}</p>
      <h1 class="slogan"><span class="sr-only">{t('hero.brandPrefix')}</span>{sloganA}<em>{sloganEm}</em>{sloganB}</h1>
      <div class="pitch" data-pitch data-guest-line={t('hero.guest.line')} data-guest-cta={t('hero.guest.cta')}>
        <p class="line" aria-live="polite" data-pitch-line>{t('hero.line')}</p>
      </div>
      <CastLineup />
    </div>

    {
      shown && (
        <figure class="frame-wrap">
          <span class="sconce s1" aria-hidden="true"></span>
          <span class="sconce s2" aria-hidden="true"></span>
          <a
            class="frame gilt"
            href={`/episodes/${shown.slug}`}
            {...playerData(shown, known(shown))}
            aria-label={`${t('hero.frameLabel')}: ${shown.title}`}
          >
            {heroSrc ? (
              <video
                data-hero-video
                muted
                loop
                playsinline
                preload="none"
                poster={shown.thumbnailUrl || undefined}
                width="360"
                height="640"
                aria-label={t('hero.videoLabel')}
              >
                <source data-src={heroSrc} type="video/mp4" />
              </video>
            ) : shown.thumbnailUrl ? (
              <img src={shown.thumbnailUrl} width="360" height="640" alt={`${t('episodes.thumbAlt')} ${shown.title}`} />
            ) : (
              <img src={characters.nora.full} width="600" height="800" alt={`${t('cats.portraitAlt')} Nora`} />
            )}
            <span class="play" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
            </span>
          </a>
          {heroSrc && (
            <button
              type="button"
              class="sound"
              data-sound
              aria-pressed="false"
              data-on={t('common.soundOn')}
              data-off={t('common.soundOff')}
              data-play={t('common.playPreview')}
            >
              {t('common.soundOn')}
            </button>
          )}
          <figcaption><span class="plate">{t('hero.nowShowing')} · {shown.title}</span></figcaption>
        </figure>
      )
    }
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const btn = document.querySelector<HTMLButtonElement>('[data-sound]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // The preview video is not part of first paint: its source is attached after the page has
  // loaded, so it never competes with fonts and images on a slow phone connection.
  let visible = true;
  const attach = () => {
    const src = v?.querySelector<HTMLSourceElement>('source[data-src]');
    if (!v || !src) return;
    src.src = src.dataset.src ?? '';
    src.removeAttribute('data-src');
    v.load();
  };
  if (v) {
    const start = () => {
      attach();
      if (!reduce && visible) void v.play().catch(() => {});
    };
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  }

  if (v && btn) {
    if (reduce) btn.textContent = btn.dataset.play ?? '';
    btn.addEventListener('click', () => {
      attach();
      if (v.paused) {
        v.muted = false;
        void v.play();
      } else {
        v.muted = !v.muted;
      }
      btn.setAttribute('aria-pressed', String(!v.muted));
      btn.textContent = (v.muted ? btn.dataset.on : btn.dataset.off) ?? '';
    });
  }

  // A visitor's cat joined the lineup (CastLineup): make the pitch personal.
  const pitch = document.querySelector<HTMLElement>('[data-pitch]');
  if (pitch) {
    const line = pitch.querySelector<HTMLElement>('[data-pitch-line]')!;
    const cta = document.querySelector<HTMLElement>('[data-pitch-cta]');
    document.addEventListener('ttw:guest', (ev) => {
      const name = String((ev as CustomEvent<{ name: string }>).detail?.name ?? '').slice(0, 30);
      line.textContent = (pitch.dataset.guestLine ?? '').replace('{name}', name);
      if (cta) cta.textContent = (pitch.dataset.guestCta ?? '').replace('{name}', name);
      pitch.classList.add('is-personal');
    });
  }

  // Pause the muted preview while the hero is off screen.
  if (hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => {
      hero.classList.toggle('offscreen', !e.isIntersecting);
      visible = e.isIntersecting;
      if (v && v.muted && !reduce && !v.querySelector('source[data-src]')) {
        if (e.isIntersecting) void v.play().catch(() => {});
        else v.pause();
      }
    }).observe(hero);
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    margin-block-start: calc(var(--header-h) * -1);
    padding-block: calc(var(--header-h) + var(--space-3)) var(--space-4);
    overflow: clip;
    isolation: isolate;
    background: transparent;
  }
  /* A calm panelled wall with a dado rail and two brass sconces: the room the cats live in. */
  .room {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background:
      linear-gradient(to bottom, transparent calc(78% - 1px), var(--c-panel-line) calc(78% - 1px) 78%, #335f4f 78% calc(78% + 6px), var(--c-panel-shade) calc(78% + 6px) calc(78% + 8px), transparent calc(78% + 8px)),
      linear-gradient(to bottom, rgb(23 50 42 / 0%) 60%, var(--c-wall) 100%);
  }
  .room::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-start: var(--header-h);
    block-size: 1.5px;
    background: linear-gradient(90deg, transparent, rgb(201 164 92 / 55%) 15%, rgb(201 164 92 / 55%) 85%, transparent);
  }
  /* Two brass sconces flank the framed episode, like the lamps beside a painting. */
  .sconce {
    position: absolute;
    z-index: -1;
    inset-block-start: 16%;
    inline-size: 30px;
    block-size: 64px;
    pointer-events: none;
  }
  .sconce::before {
    content: '';
    position: absolute;
    inset: -220px -200px;
    background: radial-gradient(closest-side, rgb(255 207 110 / 24%), rgb(255 207 110 / 7%) 55%, transparent);
  }
  .sconce::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, #fbf1dc, var(--c-paper) 60%, #e7d4b0) center top / 30px 26px no-repeat,
      linear-gradient(var(--c-brass), var(--c-brass)) center 26px / 4px 26px no-repeat,
      radial-gradient(circle, var(--c-brass) 60%, transparent 62%) center 50px / 12px 12px no-repeat;
    border-radius: 6px 6px 0 0;
    filter: drop-shadow(0 0 10px rgb(255 207 110 / 60%));
  }
  .s1 {
    inset-inline-end: calc(100% + 1.6rem);
  }
  .s2 {
    inset-inline-start: calc(100% + 1.6rem);
  }
  .slogan {
    max-inline-size: 18ch;
    margin-block-end: var(--space-2);
    color: var(--c-paper);
    font: 600 clamp(2.2rem, 1.4rem + 2.9vw, 4.1rem) / 1.06 var(--font-serif);
    letter-spacing: -0.018em;
    text-shadow: 0 2px 30px rgb(var(--c-shadow) / 70%);
  }
  .slogan em {
    font-style: italic;
    color: var(--c-lamp);
  }
  /* Smooth fade into the page colour. */
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    block-size: 28%;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(to bottom, rgb(23 50 42 / 0%), rgb(23 50 42 / 80%) 55%, var(--c-wall) 88%);
  }
  .grid {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-5);
    }
  }
  .copy {
    min-inline-size: 0;
  }
  .pitch {
    display: grid;
    justify-items: start;
    margin-block-end: var(--space-3);
  }
  .is-personal .line {
    color: var(--c-lamp);
  }
  .line {
    max-inline-size: 34ch;
    margin: 0;
    color: var(--c-paper-2);
    font: 600 clamp(1.05rem, 0.95rem + 0.4vw, 1.3rem) / 1.35 var(--font-display);
  }
  .frame-wrap {
    position: relative;
    margin: 0;
    justify-self: center;
    inline-size: clamp(13rem, 3rem + 12vw, 20rem);
  }
  /* The latest episode hangs on the wall in a gilt frame, like the paintings in Nora's house. */
  .frame {
    --gilt-w: 14px;
    position: relative;
    display: block;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    box-shadow:
      inset 0 0 0 1px rgb(110 82 32 / 80%),
      inset 0 0 0 4px rgb(240 216 146 / 35%),
      0 40px 80px -24px rgb(var(--c-shadow) / 95%),
      0 0 140px -10px rgb(255 207 110 / 32%);
    transition: transform 0.25s ease;
  }
  .frame:hover {
    transform: scale(1.012);
  }
  .frame video,
  .frame img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .play {
    position: absolute;
    inset-inline-start: 1.6rem;
    inset-block-end: 1.6rem;
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    border-radius: 50%;
    background: var(--c-mustard);
    color: var(--c-on-mustard);
  }
  .play svg {
    margin-inline-start: 2px;
  }
  .sound {
    position: absolute;
    inset-inline-end: -0.75rem;
    inset-block-start: 1.5rem;
    min-block-size: 2.5rem;
    padding-inline: 1rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--c-paper);
    color: var(--c-ink);
    font: 600 0.95rem var(--font-display);
    cursor: pointer;
    box-shadow: 0 10px 24px -8px rgb(var(--c-shadow) / 80%);
  }
  .sound[aria-pressed='true'] {
    background: var(--c-lamp);
  }
  figcaption {
    margin-block-start: var(--space-2);
    text-align: center;
  }
  figcaption .plate {
    max-inline-size: 100%;
    line-height: 1.35;
  }

  /* One orchestrated entrance. */
  @media (prefers-reduced-motion: no-preference) {
    .copy :global([data-lineup]) {
      animation: rise 0.55s 0.12s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
    .pitch {
      animation: rise 0.55s 0.05s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
    .frame-wrap {
      animation: drop 0.6s 0.3s cubic-bezier(0.3, 1.5, 0.5, 1) both;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-40px);
    }
  }

  @media (max-width: 63.99rem) {
    .hero {
      min-block-size: 0;
      align-items: start;
      padding-block: calc(var(--header-h) + var(--space-3)) var(--space-4);
    }
    .frame-wrap {
      order: -1;
      inline-size: min(36vw, 12rem);
    }
    .play {
      inline-size: 36px;
      block-size: 36px;
      inset-inline-start: 0.6rem;
      inset-block-end: 0.6rem;
    }
    .grid {
      gap: var(--space-3);
    }
    figcaption {
      display: none;
    }
    .sound {
      inset-inline-end: -1.5rem;
    }
    .pitch {
      justify-items: center;
      text-align: center;
      margin-block-end: var(--space-2);
    }
    .kicker,
    .slogan {
      text-align: center;
      margin-inline: auto;
    }
    .line {
      font-size: 1.05rem;
    }
    .slogan {
      max-inline-size: none;
      font-size: clamp(1.9rem, 1.2rem + 3.6vw, 2.6rem);
    }
    .sconce {
      display: none;
    }
    .frame {
      --gilt-w: 9px;
    }
  }
  @media (max-width: 47.99rem) {
    .pitch {
      justify-items: stretch;
      text-align: start;
    }
    .kicker,
    .slogan {
      text-align: start;
      margin-inline: 0;
    }
  }
</style>
