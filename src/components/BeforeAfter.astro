---
import { t } from '../i18n/t';
---

<div class="ba" style="--pos:50%">
  <img class="after" src="/img/tango/after.webp" width="640" height="640" loading="lazy" alt={t('showcase.afterAlt')} />
  <img class="before" src="/img/tango/before.webp" width="640" height="640" loading="lazy" alt={t('showcase.beforeAlt')} />
  <input type="range" min="0" max="100" value="50" aria-label={t('showcase.sliderLabel')} />
  <span class="tag l">{t('showcase.before')}</span>
  <span class="tag r">{t('showcase.after')}</span>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.ba').forEach((ba) => {
    const input = ba.querySelector('input')!;
    input.addEventListener('input', () => ba.style.setProperty('--pos', `${input.value}%`));
  });
</script>

<style>
  .ba {
    position: relative;
    inline-size: min(100%, 26rem);
    aspect-ratio: 1;
    margin-inline: auto;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--c-caddy);
  }
  img {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .before {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  input {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .ba::after {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--pos);
    inline-size: 4px;
    background: var(--c-mustard);
    pointer-events: none;
  }
  .ba:focus-within {
    outline: 3px solid var(--c-ink);
  }
  .tag {
    position: absolute;
    inset-block-end: var(--space-1);
    padding-inline: 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--c-cream);
    font-size: 0.85rem;
    font-weight: 600;
    pointer-events: none;
  }
  .l {
    inset-inline-start: var(--space-1);
  }
  .r {
    inset-inline-end: var(--space-1);
  }
</style>
