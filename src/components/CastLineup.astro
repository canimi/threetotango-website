---
import { t } from '../i18n/t';
import { characters } from '../data/characters';
import { lineupCats, type LineupCat } from '../lib/cast-assets';

interface Props {
  /** Injectable for tests; defaults to the build-time filesystem check. */
  cats?: LineupCat[];
}
const { cats = lineupCats() } = Astro.props;
const cutouts = cats.length > 0 && cats.every((c) => c.cutout);
// Believable relative sizes on the shared floor (fraction of the figure box height):
// Budy sits tallest (ears), Caddy is the widest silhouette, Luka is the compact one.
const scale: Record<string, number> = { luka: 0.86, budy: 0.97, caddy: 0.9 };
---

<div class:list={['lineup', cutouts ? 'is-cutout' : 'is-portrait']} data-lineup role="group" aria-label={t('hero.lineupLabel')}>
  <div class="row" data-lineup-row>
    {
      cats.map((c) => {
        const ch = characters[c.id];
        return (
          <a
            class="cat"
            href={`/cats/${c.id}`}
            data-cast-open={c.id}
            style={`--accent:${ch.color};--k:${scale[c.id] ?? 0.9}`}
            aria-label={t('hero.meet').replace('{name}', ch.name)}
          >
            <span class="bubble" aria-hidden="true">{t(`hero.bubbles.${c.id}`)}</span>
            <span class="figure">
              {cutouts && c.cutout ? (
                <img src={c.cutout} width={c.width ?? 800} height={c.height ?? 900} alt="" loading="eager" fetchpriority="high" />
              ) : (
                <img src={c.face} width="400" height="400" alt="" loading="eager" fetchpriority="high" />
              )}
            </span>
            <span class="name" aria-hidden="true">{ch.name}</span>
          </a>
        );
      })
    }
    <a class="cat slot" href="/tango-me" data-drop aria-label={t('hero.yourCatLabel')}>
      <span class="figure">
        {
          cutouts ? (
            <svg class="sil sil-sit" viewBox="0 0 100 120" aria-hidden="true">
              <path d="M30 116 C25 104 25 90 30 80 C27 73 26 65 28 58 C23 53 21 45 23 38 L22 20 L34 28 C39 26 45 26 50 28 L61 19 L61 38 C62 46 60 52 56 57 C71 62 83 77 86 95 C88 107 84 116 76 116 Z" />
              <path class="tail" d="M77 116 C91 117 99 108 96 96" />
            </svg>
          ) : (
            <svg class="sil" viewBox="0 0 120 160" aria-hidden="true">
              <path d="M30 154 C21 121 27 93 42 79 C34 70 31 58 34 46 L29 16 L49 33 C56 30 64 30 71 33 L91 16 L86 46 C89 58 86 70 78 79 C93 93 99 121 90 154 Z M90 150 C108 149 116 130 104 113" />
            </svg>
          )
        }
        <span class="drop-msg" aria-hidden="true">{t('hero.dropNow')}</span>
      </span>
      <span class="name">{t('hero.yourCat')}</span>
      <span class="hint" aria-hidden="true">{t('hero.yourCatHint')}</span>
    </a>
    <input type="file" accept="image/*,.heic" data-drop-input hidden tabindex="-1" aria-hidden="true" />
  </div>
  <div class="floor" aria-hidden="true"></div>
</div>

<script>
  import { idbKV, stashPhoto } from '../lib/pending-photo';

  const root = document.querySelector<HTMLElement>('[data-lineup]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Cat → select it in the cast picker on this page (falls back to the profile link).
  root?.querySelectorAll<HTMLAnchorElement>('[data-cast-open]').forEach((a) => {
    a.addEventListener('click', (ev) => {
      const tab = document.getElementById(`cast-tab-${a.dataset.castOpen}`);
      const section = document.getElementById('household');
      if (!tab || !section || ev.metaKey || ev.ctrlKey || ev.shiftKey) return;
      ev.preventDefault();
      tab.click();
      section.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      tab.focus({ preventScroll: true });
    });
  });

  // "+ Your cat": click to pick, or drop a photo; hand it to /tango-me via IndexedDB.
  const slot = root?.querySelector<HTMLAnchorElement>('[data-drop]');
  const input = root?.querySelector<HTMLInputElement>('[data-drop-input]');
  if (slot && input) {
    const go = async (file: File | undefined) => {
      if (file && 'indexedDB' in window) {
        try {
          await stashPhoto(idbKV(), file);
        } catch {
          /* storage blocked: Tango Me just starts empty */
        }
      }
      window.location.assign(slot.href);
    };
    slot.addEventListener('click', (ev) => {
      if (ev.metaKey || ev.ctrlKey || ev.shiftKey) return;
      ev.preventDefault();
      input.click();
    });
    input.addEventListener('change', () => void go(input.files?.[0]));
    let depth = 0;
    slot.addEventListener('dragenter', (ev) => {
      ev.preventDefault();
      depth++;
      slot.classList.add('is-over');
    });
    slot.addEventListener('dragover', (ev) => {
      ev.preventDefault();
      if (ev.dataTransfer) ev.dataTransfer.dropEffect = 'copy';
    });
    slot.addEventListener('dragleave', () => {
      depth = Math.max(0, depth - 1);
      if (!depth) slot.classList.remove('is-over');
    });
    slot.addEventListener('drop', (ev) => {
      ev.preventDefault();
      depth = 0;
      slot.classList.remove('is-over');
      const f = Array.from(ev.dataTransfer?.files ?? []).find(
        (x) => x.type.startsWith('image/') || /\.(heic|heif)$/i.test(x.name),
      );
      if (f) void go(f);
    });
  }
</script>

<style>
  /* Sized from the lineup's own width (container query units), so it fills whatever column it gets. */
  .lineup {
    position: relative;
    container-type: inline-size;
  }
  .row {
    --gap: clamp(0.75rem, 2.2cqi, 2.25rem);
    --figure: clamp(6.5rem, (100cqi - 3 * var(--gap)) / 4.15, 16rem);
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: var(--gap);
  }
  .cat {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.6rem;
    flex: 0 0 auto;
    min-inline-size: 44px;
    color: var(--c-paper);
    text-decoration: none;
    outline: none;
  }
  .figure {
    position: relative;
    display: grid;
    place-items: end center;
    inline-size: var(--figure);
    transform-origin: 50% 100%;
    transition: transform 0.35s cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  .name {
    font: 600 clamp(1.05rem, 0.9rem + 0.4vw, 1.35rem) / 1.1 var(--font-display);
    text-align: center;
    text-shadow: 0 2px 12px rgb(var(--c-shadow) / 80%);
  }
  .cat:hover .figure,
  .cat:focus-visible .figure {
    transform: rotate(-4deg) scale(1.04);
  }
  .cat:focus-visible .name {
    outline: 3px solid var(--c-lamp);
    outline-offset: 4px;
    border-radius: 6px;
  }

  /* ---- Fallback: round face portholes ---- */
  .is-portrait .figure {
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--c-wall-2);
    box-shadow:
      0 0 0 4px var(--c-wall),
      0 0 0 7px var(--accent),
      0 28px 40px -18px rgb(var(--c-shadow) / 95%);
  }
  .is-portrait .figure img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .is-portrait .cat:focus-visible .figure {
    box-shadow:
      0 0 0 4px var(--c-wall),
      0 0 0 7px var(--c-lamp),
      0 28px 40px -18px rgb(var(--c-shadow) / 95%);
  }
  .is-portrait .slot .figure {
    border-radius: 50%;
    border: 3px dashed var(--c-mustard);
    background: rgb(227 162 26 / 8%);
    place-items: center;
  }
  .is-portrait .slot:hover .figure,
  .is-portrait .slot:focus-visible .figure,
  .is-portrait .slot.is-over .figure {
    background: rgb(255 207 110 / 18%);
    border-color: var(--c-lamp);
  }
  .is-portrait .slot:focus-visible .figure {
    box-shadow: 0 0 0 4px var(--c-wall), 0 0 0 7px var(--c-lamp);
  }
  .is-portrait .sil {
    inline-size: 58%;
  }
  .floor {
    position: absolute;
    z-index: 0;
    inset-inline: -4%;
    inset-block-end: 2.2rem;
    block-size: 3.5rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(var(--c-shadow) / 75%), transparent);
    pointer-events: none;
  }

  /* ---- Cutouts: four even columns, one floor line ---- */
  /* (vars hold cqi tokens; they resolve where used, against .lineup) */
  .is-cutout {
    --col: calc(100cqi / 4);
    --F: min(calc(var(--col) * 1.24), 56svh);
  }
  .is-cutout .row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
  }
  .is-cutout .figure {
    inline-size: 100%;
    block-size: var(--F);
  }
  .is-cutout .figure img {
    position: relative;
    z-index: 1;
    inline-size: auto;
    block-size: calc(var(--F) * var(--k));
    max-inline-size: 112%; /* at most ~6% into each neighbour */
    object-fit: contain;
    object-position: 50% 100%;
  }
  /* Soft contact shadow where each cat meets the floor */
  .is-cutout .figure::after {
    content: '';
    position: absolute;
    z-index: 0;
    inset-inline: 10%;
    inset-block-end: -0.55rem;
    block-size: 1.4rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(var(--c-shadow) / 85%), rgb(var(--c-shadow) / 0%));
  }
  .is-cutout .floor {
    inset-inline: 0;
    inset-block-end: auto;
    inset-block-start: calc(var(--F) - 0.25rem);
    block-size: 1px;
    border-radius: 0;
    background: linear-gradient(90deg, transparent, rgb(255 207 110 / 22%) 15%, rgb(255 207 110 / 22%) 85%, transparent);
  }
  .is-cutout .sil-sit {
    position: relative;
    z-index: 1;
    block-size: calc(var(--F) * 0.8);
    inline-size: auto;
  }
  .is-cutout .slot .figure::after {
    inset-inline: 22%;
    opacity: 0.6;
  }

  /* The empty spot's silhouette (both modes) */
  .sil {
    fill: rgb(227 162 26 / 12%);
    stroke: var(--c-mustard);
    stroke-width: 2.5;
    stroke-dasharray: 6 5;
    stroke-linejoin: round;
    stroke-linecap: round;
    overflow: visible;
    transition: fill 0.2s ease, stroke 0.2s ease;
  }
  .sil .tail {
    fill: none;
  }
  .slot:hover .sil,
  .slot:focus-visible .sil,
  .slot.is-over .sil {
    fill: rgb(255 207 110 / 26%);
    stroke: var(--c-lamp);
  }
  .is-cutout .slot:focus-visible .sil {
    stroke-width: 3.5;
  }
  .slot .name {
    color: var(--c-lamp);
  }
  .hint {
    position: absolute;
    inset-block-start: calc(100% + 0.2rem);
    inset-inline: -1rem;
    text-wrap: balance;
    color: var(--c-paper-2);
    font-size: 0.85rem;
    line-height: 1.3;
    text-align: center;
  }
  .drop-msg {
    position: absolute;
    z-index: 2;
    inset-inline: 8%;
    inset-block-end: 35%;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-pill);
    background: rgb(23 50 42 / 88%);
    color: var(--c-lamp);
    font: 600 0.95rem / 1.2 var(--font-display);
    text-align: center;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .slot.is-over .drop-msg {
    opacity: 1;
  }
  .slot.is-over .figure {
    transform: scale(1.06);
  }

  /* Speech bubble: paper, little tail, pops on hover/focus. */
  .bubble {
    position: absolute;
    z-index: 3;
    inset-block-start: -0.4rem;
    inset-inline-start: 58%;
    padding: 0.35rem 0.8rem;
    border-radius: 1.1rem 1.1rem 1.1rem 0.25rem;
    background: var(--c-paper);
    color: var(--c-ink);
    font: 600 0.98rem / 1.2 var(--font-display);
    white-space: nowrap;
    box-shadow: 0 10px 22px -10px rgb(var(--c-shadow) / 90%);
    opacity: 0;
    transform: translateY(8px) scale(0.85);
    transform-origin: 0 100%;
    transition: opacity 0.18s ease, transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1);
    pointer-events: none;
  }
  .is-cutout .bubble {
    inset-block-start: calc(var(--F) * (1 - var(--k)) - 1.2rem);
    inset-inline-start: 52%;
  }
  .cat:hover .bubble,
  .cat:focus-visible .bubble {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .figure,
    .bubble {
      transition: none;
    }
    .cat:hover .figure,
    .cat:focus-visible .figure {
      transform: none;
    }
  }

  @media (max-width: 63.99rem) {
    .hint {
      display: none;
    }
  }

  /* Phones: one swipeable row, the empty spot first. */
  @media (max-width: 47.99rem) {
    .lineup {
      margin-inline: -16px;
    }
    .row,
    .is-cutout .row {
      --figure: clamp(6rem, 27vw, 7.5rem);
      display: flex;
      gap: 0.9rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 16px;
      padding: 1.6rem 16px 0.25rem;
      scrollbar-width: none;
    }
    .is-cutout {
      --col: clamp(8.5rem, 36vw, 10.5rem);
      --F: calc(var(--col) * 1.12);
    }
    .is-cutout .row {
      gap: 0;
    }
    .is-cutout .cat {
      inline-size: var(--col);
    }
    .row::-webkit-scrollbar {
      display: none;
    }
    .cat {
      scroll-snap-align: start;
    }
    .slot {
      order: -1;
    }
    .hint,
    .bubble {
      display: none;
    }
    .floor {
      inset-block-end: 1.4rem;
    }
    .is-cutout .floor {
      display: none;
    }
  }
</style>
