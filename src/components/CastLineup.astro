---
import { t } from '../i18n/t';
import { characters } from '../data/characters';
import { lineupCats, type LineupCat } from '../lib/cast-assets';

interface Props {
  /** Injectable for tests; defaults to the build-time filesystem check. */
  cats?: LineupCat[];
}
const { cats = lineupCats() } = Astro.props;
const cutouts = cats.length > 0 && cats.every((c) => c.cutout);
---

<div class:list={['lineup', cutouts ? 'is-cutout' : 'is-portrait']} data-lineup role="group" aria-label={t('hero.lineupLabel')}>
  <div class="row" data-lineup-row>
    {
      cats.map((c) => {
        const ch = characters[c.id];
        return (
          <a
            class="cat"
            href={`/cats/${c.id}`}
            data-cast-open={c.id}
            style={`--accent:${ch.color}`}
            aria-label={t('hero.meet').replace('{name}', ch.name)}
          >
            <span class="bubble" aria-hidden="true">{t(`hero.bubbles.${c.id}`)}</span>
            <span class="figure">
              {cutouts && c.cutout ? (
                <img src={c.cutout} width="600" height="900" alt="" decoding="async" fetchpriority="high" />
              ) : (
                <img src={c.face} width="400" height="400" alt="" decoding="async" fetchpriority="high" />
              )}
            </span>
            <span class="name" aria-hidden="true">{ch.name}</span>
          </a>
        );
      })
    }
    <a class="cat slot" href="/tango-me" data-drop aria-label={t('hero.yourCatLabel')}>
      <span class="figure">
        <svg class="sil" viewBox="0 0 120 160" aria-hidden="true">
          <path
            d="M30 154 C21 121 27 93 42 79 C34 70 31 58 34 46 L29 16 L49 33 C56 30 64 30 71 33 L91 16 L86 46 C89 58 86 70 78 79 C93 93 99 121 90 154 Z M90 150 C108 149 116 130 104 113"
          ></path>
        </svg>
        <span class="drop-msg" aria-hidden="true">{t('hero.dropNow')}</span>
      </span>
      <span class="name">{t('hero.yourCat')}</span>
      <span class="hint" aria-hidden="true">{t('hero.yourCatHint')}</span>
    </a>
    <input type="file" accept="image/*,.heic" data-drop-input hidden tabindex="-1" aria-hidden="true" />
  </div>
  <div class="floor" aria-hidden="true"></div>
</div>

<script>
  import { idbKV, stashPhoto } from '../lib/pending-photo';

  const root = document.querySelector<HTMLElement>('[data-lineup]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Cat → select it in the cast picker on this page (falls back to the profile link).
  root?.querySelectorAll<HTMLAnchorElement>('[data-cast-open]').forEach((a) => {
    a.addEventListener('click', (ev) => {
      const tab = document.getElementById(`cast-tab-${a.dataset.castOpen}`);
      const section = document.getElementById('household');
      if (!tab || !section || ev.metaKey || ev.ctrlKey || ev.shiftKey) return;
      ev.preventDefault();
      tab.click();
      section.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      tab.focus({ preventScroll: true });
    });
  });

  // "+ Your cat": click to pick, or drop a photo; hand it to /tango-me via IndexedDB.
  const slot = root?.querySelector<HTMLAnchorElement>('[data-drop]');
  const input = root?.querySelector<HTMLInputElement>('[data-drop-input]');
  if (slot && input) {
    const go = async (file: File | undefined) => {
      if (file && 'indexedDB' in window) {
        try {
          await stashPhoto(idbKV(), file);
        } catch {
          /* storage blocked: Tango Me just starts empty */
        }
      }
      window.location.assign(slot.href);
    };
    slot.addEventListener('click', (ev) => {
      if (ev.metaKey || ev.ctrlKey || ev.shiftKey) return;
      ev.preventDefault();
      input.click();
    });
    input.addEventListener('change', () => void go(input.files?.[0]));
    let depth = 0;
    slot.addEventListener('dragenter', (ev) => {
      ev.preventDefault();
      depth++;
      slot.classList.add('is-over');
    });
    slot.addEventListener('dragover', (ev) => {
      ev.preventDefault();
      if (ev.dataTransfer) ev.dataTransfer.dropEffect = 'copy';
    });
    slot.addEventListener('dragleave', () => {
      depth = Math.max(0, depth - 1);
      if (!depth) slot.classList.remove('is-over');
    });
    slot.addEventListener('drop', (ev) => {
      ev.preventDefault();
      depth = 0;
      slot.classList.remove('is-over');
      const f = Array.from(ev.dataTransfer?.files ?? []).find(
        (x) => x.type.startsWith('image/') || /\.(heic|heif)$/i.test(x.name),
      );
      if (f) void go(f);
    });
  }
</script>

<style>
  /* Sized from the lineup's own width (container query units), so it fills whatever column it gets. */
  .lineup {
    position: relative;
    container-type: inline-size;
  }
  .row {
    --gap: clamp(0.75rem, 2.2cqi, 2.25rem);
    --figure: clamp(6.5rem, (100cqi - 3 * var(--gap)) / 4.15, 16rem);
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: var(--gap);
  }
  /* In cutout mode --figure is the standing height: three overlapping cats + the slot ≈ 2.4 heights wide. */
  .is-cutout .row {
    --figure: clamp(14rem, 100cqi / 2.4, min(36rem, 62svh));
    align-items: flex-end;
  }
  .is-cutout .row {
    gap: 0;
  }
  .cat {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    flex: 0 0 auto;
    min-inline-size: 44px;
    color: var(--c-paper);
    text-decoration: none;
    outline: none;
  }
  .figure {
    position: relative;
    display: grid;
    place-items: end center;
    inline-size: var(--figure);
    transform-origin: 50% 100%;
    transition: transform 0.35s cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  .is-portrait .figure {
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--c-wall-2);
    box-shadow:
      0 0 0 4px var(--c-wall),
      0 0 0 7px var(--accent),
      0 28px 40px -18px rgb(var(--c-shadow) / 95%);
  }
  .is-portrait .figure img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .is-cutout .cat:not(.slot) {
    margin-inline-end: calc(var(--figure) * -0.06);
  }
  .is-cutout .figure {
    inline-size: calc(var(--figure) * 0.62);
    block-size: var(--figure);
  }
  .is-cutout .figure img {
    inline-size: auto;
    max-inline-size: calc(var(--figure) * 0.95);
    block-size: var(--figure);
    object-fit: contain;
    object-position: 50% 100%;
    filter: drop-shadow(0 18px 18px rgb(var(--c-shadow) / 70%));
  }
  .name {
    font: 600 clamp(1.05rem, 0.9rem + 0.4vw, 1.35rem) / 1.1 var(--font-display);
    text-shadow: 0 2px 12px rgb(var(--c-shadow) / 80%);
  }
  .cat:hover .figure,
  .cat:focus-visible .figure {
    transform: rotate(-4deg) scale(1.04);
  }
  .cat:focus-visible .name {
    outline: 3px solid var(--c-lamp);
    outline-offset: 4px;
    border-radius: 6px;
  }
  .is-portrait .cat:focus-visible .figure {
    box-shadow:
      0 0 0 4px var(--c-wall),
      0 0 0 7px var(--c-lamp),
      0 28px 40px -18px rgb(var(--c-shadow) / 95%);
  }

  /* Speech bubble: paper, little tail, pops on hover/focus. */
  .bubble {
    position: absolute;
    z-index: 2;
    inset-block-start: -0.4rem;
    inset-inline-start: 58%;
    padding: 0.35rem 0.8rem;
    border-radius: 1.1rem 1.1rem 1.1rem 0.25rem;
    background: var(--c-paper);
    color: var(--c-ink);
    font: 600 0.98rem / 1.2 var(--font-display);
    white-space: nowrap;
    box-shadow: 0 10px 22px -10px rgb(var(--c-shadow) / 90%);
    opacity: 0;
    transform: translateY(8px) scale(0.85);
    transform-origin: 0 100%;
    transition: opacity 0.18s ease, transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1);
    pointer-events: none;
  }
  .is-cutout .bubble {
    inset-block-start: 6%;
  }
  .cat:hover .bubble,
  .cat:focus-visible .bubble {
    opacity: 1;
    transform: none;
  }

  /* The empty spot: dashed mustard silhouette, and the drop zone. */
  .slot .figure {
    aspect-ratio: 1;
    border-radius: 50%;
    border: 3px dashed var(--c-mustard);
    background: rgb(227 162 26 / 8%);
    place-items: center;
    transition:
      transform 0.35s cubic-bezier(0.3, 1.4, 0.5, 1),
      background-color 0.2s ease,
      border-color 0.2s ease;
  }
  .is-cutout .slot {
    margin-inline-start: calc(var(--figure) * 0.12);
  }
  .is-cutout .slot .figure {
    inline-size: calc(var(--figure) * 0.5);
    block-size: auto;
  }
  .sil {
    inline-size: 58%;
    block-size: auto;
    fill: rgb(227 162 26 / 16%);
    stroke: var(--c-mustard);
    stroke-width: 3;
    stroke-dasharray: 7 6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .slot .name {
    color: var(--c-lamp);
  }
  .hint {
    position: absolute;
    inset-block-start: calc(100% + 0.2rem);
    inset-inline: -1rem;
    text-wrap: balance;
    color: var(--c-paper-2);
    font-size: 0.85rem;
    line-height: 1.3;
    text-align: center;
  }
  .slot:hover .figure,
  .slot:focus-visible .figure,
  .slot.is-over .figure {
    background: rgb(255 207 110 / 18%);
    border-color: var(--c-lamp);
  }
  .slot:focus-visible .figure {
    box-shadow: 0 0 0 4px var(--c-wall), 0 0 0 7px var(--c-lamp);
  }
  .drop-msg {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    border-radius: 50%;
    background: rgb(23 50 42 / 82%);
    color: var(--c-lamp);
    font: 600 0.95rem / 1.2 var(--font-display);
    text-align: center;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .slot.is-over .drop-msg {
    opacity: 1;
  }
  .slot.is-over .figure {
    transform: scale(1.08);
  }

  .floor {
    position: absolute;
    z-index: 0;
    inset-inline: -4%;
    inset-block-end: 2.2rem;
    block-size: 3.5rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(var(--c-shadow) / 75%), transparent);
    pointer-events: none;
  }
  .is-cutout .floor {
    inset-block-end: 1.9rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .figure,
    .bubble {
      transition: none;
    }
    .cat:hover .figure,
    .cat:focus-visible .figure {
      transform: none;
    }
  }

  /* Phones: one swipeable row, the empty spot first. */
  @media (max-width: 47.99rem) {
    .lineup {
      margin-inline: -16px;
    }
    .row {
      --figure: clamp(6rem, 27vw, 7.5rem);
      gap: 0.9rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 16px;
      padding: 1.6rem 16px 0.25rem;
      scrollbar-width: none;
    }
    .row::-webkit-scrollbar {
      display: none;
    }
    .is-cutout .row {
      --figure: clamp(10rem, 46vw, 13rem);
    }
    .cat {
      scroll-snap-align: start;
    }
    .slot {
      order: -1;
    }
    .hint {
      display: none;
    }
    .bubble {
      display: none;
    }
    .floor {
      inset-block-end: 1.4rem;
    }
  }
</style>
