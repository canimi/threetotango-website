---
import { t } from '../i18n/t';
import WalkingCats from './WalkingCats.astro';
import { social } from '../data/social';

interface Props {
  path: string;
}
const { path } = Astro.props;
const links = [
  { href: '/episodes', label: t('nav.episodes') },
  { href: '/cats', label: t('nav.cats') },
  { href: '/gallery', label: t('nav.gallery') },
  { href: '/quiz', label: t('nav.quiz') },
];
const current = (href: string) => path === href || path.startsWith(`${href}/`);
---

<div class="header-sentinel" data-header-sentinel aria-hidden="true"></div>
<header class="site-header" data-site-header>
  <WalkingCats />
  <div class="container bar">
    <a class="wordmark" href="/" aria-label={t('nav.home')}>Three <span class="to">To</span> Tango</a>
    <nav class="nav-wide" aria-label={t('nav.main')}>
      <ul>
        {links.map((l) => <li><a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
    <ul class="social" aria-label={t('nav.social')}>
      <li>
        <a class="soc" href={social.instagram} target="_blank" rel="noopener" aria-label={t('footer.instagram')}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.2" fill="currentColor" stroke="none"/></svg>
        </a>
      </li>
      <li>
        <a class="soc" href={social.youtube} target="_blank" rel="noopener" aria-label={t('footer.youtube')}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M22.5 7.2a3 3 0 0 0-2.1-2.1C18.5 4.6 12 4.6 12 4.6s-6.5 0-8.4.5A3 3 0 0 0 1.5 7.2 31 31 0 0 0 1 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.4.5 8.4.5s6.5 0 8.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 23 12a31 31 0 0 0-.5-4.8ZM9.8 15.1V8.9l5.4 3.1-5.4 3.1Z"/></svg>
        </a>
      </li>
    </ul>
    <a class="btn head-cta" href="/tango-me" data-magnetic>
      <span class="long">{t('cta.tangoFree')}</span>
      <span class="short">{t('cta.tangoCompact')}</span>
    </a>
    <details class="menu">
      <summary aria-label={t('nav.menu')}>
        <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
      </summary>
      <nav class="menu-panel" aria-label={t('nav.main')}>
        <ul>
          {links.map((l) => <li><a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
          <li class="menu-soc"><a href={social.instagram} target="_blank" rel="noopener">{t('footer.instagram')}</a></li>
          <li class="menu-soc"><a href={social.youtube} target="_blank" rel="noopener">{t('footer.youtube')}</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const sentinel = document.querySelector<HTMLElement>('[data-header-sentinel]');
  if (header && sentinel && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      header.classList.toggle('is-scrolled', !entry.isIntersecting);
    }).observe(sentinel);
  }
</script>

<style>
  .header-sentinel {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: 1px;
    block-size: 40px;
    pointer-events: none;
  }
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: rgb(23 50 42 / 78%);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    border-block-end: 1px solid transparent;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .site-header.is-scrolled {
    background: rgb(23 50 42 / 92%);
    border-block-end-color: rgb(255 207 110 / 14%);
  }
  .bar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    block-size: var(--header-h);
    transition: block-size 0.2s ease;
  }
  .is-scrolled .bar {
    block-size: 56px;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.28em;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.45rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--c-paper);
    white-space: nowrap;
    margin-inline-end: auto;
  }
  .to {
    display: inline-block;
    padding-inline: 0.32em;
    border-radius: 0.38em;
    background: var(--c-mustard);
    color: var(--c-on-mustard);
    transform: rotate(-4deg);
  }
  ul {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-wide a,
  .menu-panel a {
    display: block;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-pill);
    color: var(--c-paper);
    font-weight: 600;
    text-decoration: none;
  }
  .nav-wide a:hover,
  .nav-wide a[aria-current='page'] {
    background: rgb(244 233 216 / 10%);
  }
  .nav-wide a[aria-current='page'] {
    color: var(--c-lamp);
  }
  .social {
    gap: 0.5rem;
  }
  .soc {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: 50%;
    background: var(--c-mustard);
    color: var(--c-on-mustard);
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
  .soc:hover {
    background: var(--c-lamp);
    transform: translateY(-2px);
  }
  .soc:focus-visible {
    outline: 3px solid var(--c-lamp);
    outline-offset: 3px;
  }
  .menu-soc {
    display: none;
  }
  .head-cta {
    min-block-size: 44px;
    padding-inline: 1.2rem;
    font-size: 1rem;
    white-space: nowrap;
  }
  .short {
    display: none;
  }
  .menu {
    display: none;
    position: relative;
  }
  summary {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 50%;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .burger {
    display: grid;
    gap: 4px;
  }
  .burger i {
    display: block;
    inline-size: 20px;
    block-size: 2px;
    border-radius: 2px;
    background: var(--c-paper);
  }
  .menu[open] summary {
    background: rgb(244 233 216 / 12%);
  }
  .menu-panel {
    position: absolute;
    inset-inline-end: 0;
    inset-block-start: calc(100% + 0.5rem);
    min-inline-size: 12rem;
    padding: var(--space-1);
    border-radius: 20px;
    background: var(--c-wall-2);
    box-shadow: 0 20px 40px -12px rgb(var(--c-shadow) / 80%);
  }
  .menu-panel ul {
    flex-direction: column;
    gap: 2px;
  }
  .menu-panel a {
    padding: 0.7rem 1rem;
  }
  @media (max-width: 52rem) {
    .bar {
      gap: var(--space-1);
      block-size: 58px;
    }
    .nav-wide {
      display: none;
    }
    .menu {
      display: block;
    }
    .wordmark {
      font-size: 1.2rem;
    }
  }
  @media (max-width: 30rem) {
    .social {
      display: none;
    }
    .menu-soc {
      display: block;
    }
    .long {
      display: none;
    }
    .short {
      display: inline;
    }
    .head-cta {
      min-block-size: 44px;
      padding-inline: 0.95rem;
      font-size: 0.95rem;
    }
  }
  @media (max-width: 23.5rem) {
    .wordmark {
      font-size: 1.05rem;
    }
    .head-cta {
      padding-inline: 0.8rem;
      font-size: 0.9rem;
    }
  }
</style>
