---
/**
 * Each character's page carries that character's own temperament (TTW_09 §6):
 * Luka a case file, Budy bubbles that never stop, Caddy a page that does not move, Nora a desk.
 */
import en from '../i18n/en.json';
import { characters } from '../data/characters';
import type { CharacterId } from '../lib/episodes';

interface Props {
  id: CharacterId;
  compact?: boolean;
}
const { id, compact = false } = Astro.props;
const f = en.finish;
---

{
  id === 'luka' && (
    <section class:list={['finish', 'luka', { compact }]} aria-label={f.luka.kicker}>
      <div class="file">
        <img class="perch" src="/img/cast/cast-luka.webp" width="400" height="450" alt="" loading="lazy" decoding="async" />
        <p class="conf">{f.luka.confidential}</p>
        <p class="kicker dark">{f.luka.kicker}</p>
        <h2 class="file-title">{f.luka.title}</h2>
        <div class="file-body">
          <dl>
            {f.luka.rows.map(([a, b]) => (
              <div>
                <dt>{a}</dt>
                <dd>{b}</dd>
              </div>
            ))}
          </dl>
          <figure class="exhibit">
            <img src={characters.nora.face} width="400" height="400" alt="" loading="lazy" decoding="async" />
            <figcaption>{f.luka.exhibit}</figcaption>
          </figure>
        </div>
        <p class="verdict">
          <span>{f.luka.verdict}</span>
          <strong class="stamp">{f.luka.stamp}</strong>
        </p>
      </div>
    </section>
  )
}

{
  id === 'budy' && (
    <section class:list={['finish', 'budy', { compact }]} aria-label={f.budy.kicker}>
      <p class="kicker">{f.budy.kicker}</p>
      <h2>{f.budy.title}</h2>
      <ul class="bubbles" aria-hidden="true">
        {f.budy.bubbles.map((b, i) => (
          <li class:list={['b', `b${i}`, { loud: b === b.toUpperCase(), green: b === 'LETTUCE.' }]}>{b}</li>
        ))}
      </ul>
      <p class="typing">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        {f.budy.typing}
      </p>
      <p class="weak">
        <span class="peas" aria-hidden="true"><i></i><i></i><i></i></span>
        {f.budy.weakness}: {f.budy.green.join(', ')}
      </p>
    </section>
  )
}

{
  id === 'caddy' && (
    <section class:list={['finish', 'caddy', { compact }]} aria-label={f.caddy.kicker} data-caddy-still>
      <div class="hanger" aria-hidden="true">
        <span class="hole"></span>
        <span class="zzz">{f.caddy.hanger}</span>
        <span class="since">{f.caddy.since}</span>
      </div>
      <p class="kicker dark">{f.caddy.kicker}</p>
      <h2>{f.caddy.title}</h2>
      <p class="still">{f.caddy.still}</p>
      <p class="hint">{f.caddy.hint}</p>
    </section>
  )
}

{
  id === 'nora' && (
    <section class:list={['finish', 'nora', { compact }]} aria-label={f.nora.kicker}>
      <div class="desk gilt">
        <img
          src="/img/house/nora-desk-1600.webp"
          srcset="/img/house/nora-desk-900.webp 900w, /img/house/nora-desk-1600.webp 1600w"
          sizes="(min-width: 60rem) 56rem, 92vw"
          width="1600"
          height="900"
          alt="Nora at her laptop while Luka supervises from the table"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="notes">
        <p class="kicker">{f.nora.kicker}</p>
        <h2>{f.nora.title}</h2>
        <ul>
          {f.nora.notes.map((n) => (
            <li>{n}</li>
          ))}
        </ul>
        <p class="cap">{f.nora.caption}</p>
      </div>
    </section>
  )
}

<script>
  // Caddy: the fifteenth click is the one time she loses it (the "big moment" of the series).
  const still = document.querySelector<HTMLElement>('[data-caddy-still]');
  const portrait = document.querySelector<HTMLElement>('[data-living="caddy"]');
  if (still && portrait) {
    let n = 0;
    portrait.style.cursor = 'pointer';
    portrait.addEventListener('click', () => {
      n++;
      if (n !== 15) return;
      portrait.classList.add('is-shocked');
      document.dispatchEvent(new CustomEvent('ttw:cat-sound', { detail: { cat: 'caddy' } }));
      window.setTimeout(() => portrait.classList.remove('is-shocked'), 1600);
    });
  }
</script>

<style>
  .finish {
    margin-block: var(--space-4) var(--space-5);
  }
  .kicker.dark {
    color: var(--c-ink-2);
  }
  /* ---- Luka: a case file ---- */
  .luka {
    margin-block-start: calc(var(--space-5) + 5rem);
  }
  .file {
    position: relative;
    max-inline-size: 46rem;
    margin-inline: auto;
    padding: 1.6rem clamp(1.2rem, 4vw, 2.4rem) 1.8rem;
    border-radius: 6px;
    background:
      linear-gradient(var(--c-paper-2), var(--c-paper-2)) top / 100% 2.6rem no-repeat,
      var(--c-paper);
    color: var(--c-ink);
    box-shadow: 0 30px 60px -30px rgb(var(--c-shadow) / 90%);
  }
  .perch {
    position: absolute;
    inset-block-end: calc(100% - 1.4rem);
    inset-inline-end: 1.5rem;
    inline-size: clamp(5.5rem, 4rem + 6vw, 8.5rem);
    block-size: auto;
    filter: drop-shadow(0 10px 12px rgb(0 0 0 / 35%));
    pointer-events: none;
  }
  .conf {
    margin: -0.9rem 0 1.4rem;
    color: var(--c-rug);
    font: 600 0.74rem / 1 var(--font-display);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .file-title {
    color: var(--c-ink);
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.1rem);
  }
  .file-body {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
  }
  dl {
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  dl div {
    padding-block-end: 0.6rem;
    border-block-end: 1px solid rgb(90 70 50 / 22%);
  }
  dt {
    font: 600 0.72rem / 1.2 var(--font-display);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ink-2);
  }
  dd {
    margin: 0.2rem 0 0;
    font-weight: 600;
  }
  .exhibit {
    margin: 0;
    padding: 0.4rem 0.4rem 0.2rem;
    background: #fff;
    box-shadow: 0 6px 14px -6px rgb(0 0 0 / 35%);
    transform: rotate(2deg);
  }
  .exhibit img {
    display: block;
    inline-size: clamp(5.5rem, 4rem + 5vw, 7.5rem);
    block-size: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .exhibit figcaption {
    font: italic 400 0.8rem / 1.6 var(--font-serif);
    text-align: center;
    color: var(--c-ink-2);
  }
  .verdict {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1.2rem 0 0;
    font: 600 0.72rem / 1 var(--font-display);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ink-2);
  }
  .stamp {
    padding: 0.35rem 1rem;
    border: 3px solid var(--c-rug);
    border-radius: 8px;
    color: var(--c-rug);
    font: 600 clamp(1.6rem, 1.2rem + 1.6vw, 2.4rem) / 1 var(--font-display);
    letter-spacing: 0.08em;
    transform: rotate(-7deg);
    opacity: 0.88;
  }
  @media (prefers-reduced-motion: no-preference) {
    .stamp {
      animation: stamp 0.5s 0.4s cubic-bezier(0.3, 1.6, 0.5, 1) both;
      animation-timeline: view();
      animation-range: entry 20% cover 40%;
    }
  }
  @keyframes stamp {
    from {
      transform: rotate(-7deg) scale(2.2);
      opacity: 0;
    }
  }
  @media (max-width: 34rem) {
    .file-body {
      grid-template-columns: 1fr;
    }
  }

  /* ---- Budy: bubbles that spill out of the frame ---- */
  .budy {
    position: relative;
    max-inline-size: 46rem;
    margin-inline: auto;
  }
  .bubbles {
    list-style: none;
    margin: var(--space-3) 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 0.6rem;
  }
  .b {
    padding: 0.7rem 1.3rem;
    border-radius: 24px 24px 24px 6px;
    background: var(--c-paper);
    color: var(--c-ink);
    font: 600 clamp(1.1rem, 1rem + 0.5vw, 1.35rem) / 1.1 var(--font-display);
    box-shadow: 0 8px 16px -10px rgb(var(--c-shadow) / 90%);
  }
  .b.loud {
    background: var(--c-budy);
    color: var(--c-on-mustard);
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.8rem);
  }
  .b.green {
    background: var(--c-lettuce);
    color: var(--c-on-mustard);
    font-size: clamp(1.7rem, 1.4rem + 1.2vw, 2.3rem);
  }
  .b:nth-child(odd) {
    transform: rotate(-1.5deg);
  }
  .b:nth-child(3n) {
    margin-inline-start: 1.2rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .b {
      animation: pop 0.45s cubic-bezier(0.3, 1.6, 0.5, 1) both;
    }
    .b1 { animation-delay: 0.15s; }
    .b2 { animation-delay: 0.3s; }
    .b3 { animation-delay: 0.45s; }
    .b4 { animation-delay: 0.6s; }
    .b5 { animation-delay: 0.75s; }
    .b6 { animation-delay: 0.9s; }
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.85);
    }
  }
  .typing {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    background: rgb(244 233 216 / 10%);
    color: var(--c-paper-2);
    font-weight: 600;
  }
  .dots {
    display: inline-flex;
    gap: 4px;
  }
  .dots i {
    inline-size: 7px;
    block-size: 7px;
    border-radius: 50%;
    background: var(--c-budy);
  }
  @media (prefers-reduced-motion: no-preference) {
    .dots i {
      animation: blink 1.1s infinite;
    }
    .dots i:nth-child(2) { animation-delay: 0.18s; }
    .dots i:nth-child(3) { animation-delay: 0.36s; }
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
      transform: translateY(-2px);
    }
  }
  .weak {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: var(--space-2) 0 0;
    color: var(--c-paper-2);
  }
  .peas {
    display: inline-flex;
    gap: 4px;
  }
  .peas i {
    inline-size: 11px;
    block-size: 11px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #b5dc7a, var(--c-lettuce) 60%, #5d8a2c);
  }

  /* ---- Caddy: nothing moves ---- */
  .caddy {
    position: relative;
    max-inline-size: 46rem;
    margin-inline: auto;
    padding: 2rem clamp(1.2rem, 4vw, 2.4rem) 2rem;
    border-radius: 18px;
    background: var(--c-paper);
    color: var(--c-ink);
  }
  .caddy h2 {
    color: var(--c-ink);
    max-inline-size: 14ch;
  }
  .hanger {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: clamp(1rem, 6vw, 3rem);
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    inline-size: 5rem;
    padding: 0.9rem 0 1.2rem;
    border-radius: 0 0 14px 14px;
    background: var(--c-wall);
    color: var(--c-paper);
  }
  .hole {
    inline-size: 1.9rem;
    block-size: 1.9rem;
    border-radius: 50%;
    background: var(--c-paper);
  }
  .zzz {
    font: 600 1.3rem / 1 var(--font-display);
    letter-spacing: 0.12em;
  }
  .since {
    color: var(--c-lamp);
    font: 600 0.66rem / 1.3 var(--font-display);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    max-inline-size: 4rem;
  }
  .still {
    font: italic 400 1.15rem / 1.5 var(--font-serif);
    color: var(--c-ink-2);
    max-inline-size: 30ch;
  }
  .hint {
    margin: 0;
    font-size: 0.9rem;
    color: var(--c-ink-2);
  }
  :global(.is-shocked .gilt) {
    animation: shock 0.4s cubic-bezier(0.3, 1.6, 0.5, 1) 2;
  }
  @keyframes shock {
    30% {
      transform: scale(1.06) rotate(-2deg);
    }
    60% {
      transform: scale(0.98) rotate(2deg);
    }
  }

  /* ---- Nora: the desk ---- */
  .nora {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .nora {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }
  }
  .desk {
    aspect-ratio: 16 / 9;
  }
  .notes ul {
    list-style: none;
    margin: var(--space-2) 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .notes li {
    padding: 0.8rem 0.9rem;
    max-inline-size: 11rem;
    background: #f7e27c;
    color: var(--c-ink);
    font: 600 0.95rem / 1.25 var(--font-display);
    box-shadow: 0 6px 12px -6px rgb(0 0 0 / 40%);
  }
  .notes li:nth-child(1) { transform: rotate(-2deg); }
  .notes li:nth-child(2) { transform: rotate(1.5deg); background: #f4c9a8; }
  .notes li:nth-child(3) { transform: rotate(-1deg); background: #cfe3b0; }
  .cap {
    font: italic 400 1.05rem / 1.5 var(--font-serif);
    color: var(--c-paper-2);
  }
  .compact {
    margin-block: var(--space-3);
  }
</style>
