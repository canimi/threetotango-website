---
import { t } from '../i18n/t';
import { social } from '../data/social';

const follow = [
  { href: social.instagram, label: t('footer.instagram') },
  { href: social.youtube, label: t('footer.youtube') },
];
const pages = [
  { href: '/episodes', label: t('nav.episodes') },
  { href: '/cats', label: t('nav.cats') },
  { href: '/quiz', label: t('nav.quiz') },
  { href: '/gift', label: t('links.gift') },
  { href: '/privacy', label: t('footer.privacy') },
  { href: '/contact', label: t('footer.contact') },
];
---

<footer class="site-footer">
  <div class="container inner">
    <div class="brand">
      <p class="mark">Three <span>To</span> Tango</p>
      <p class="ai">{t('footer.aiNote')}</p>
      <p class="bts">{t('footer.bts')} <a href="/behind-the-scenes">{t('footer.btsLink')}</a></p>
    </div>
    <div>
      <p class="h">{t('footer.follow')}</p>
      <ul class="social">
        {follow.map((l) => <li><a class="btn btn-ghost" href={l.href} rel="noopener" target="_blank">{l.label}</a></li>)}
      </ul>
    </div>
    <ul class="pages">
      {pages.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <p class="copy">&copy; {new Date().getFullYear()} {t('footer.copyright')}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-5) var(--space-4);
    background: var(--c-wall-2);
    color: var(--c-paper-2);
  }
  .inner {
    display: grid;
    gap: var(--space-4) var(--space-5);
  }
  @media (min-width: 52rem) {
    .inner {
      grid-template-columns: 1.4fr 1fr;
    }
    .pages,
    .copy {
      grid-column: 1 / -1;
    }
  }
  p {
    margin: 0 0 var(--space-1);
    max-inline-size: 34rem;
  }
  .mark {
    font: 600 1.6rem var(--font-display);
    color: var(--c-paper);
    margin-block-end: var(--space-2);
  }
  .mark span {
    color: var(--c-mustard);
  }
  .h {
    font: 600 1.1rem var(--font-display);
    color: var(--c-paper);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .social {
    gap: var(--space-1);
  }
  .social .btn {
    min-block-size: 2.6rem;
    font-size: 1rem;
  }
  .pages {
    padding-block-start: var(--space-3);
    border-block-start: 1px solid rgb(244 233 216 / 12%);
  }
  .pages a,
  .bts a {
    color: var(--c-paper);
    font-weight: 600;
  }
  .copy {
    font-size: var(--step--1);
  }
</style>
