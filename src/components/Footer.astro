---
import { t } from '../i18n/t';
import { social } from '../data/social';

const follow = [
  { href: social.instagram, label: t('footer.instagram') },
  { href: social.youtube, label: t('footer.youtube') },
];
const pages = [
  { href: '/episodes', label: t('nav.episodes') },
  { href: '/cats', label: t('nav.cats') },
  { href: '/quiz', label: t('nav.quiz') },
  { href: '/gift', label: t('links.gift') },
  { href: '/privacy', label: t('footer.privacy') },
  { href: '/contact', label: t('footer.contact') },
];
---

<footer class="site-footer">
  <div class="floor" aria-hidden="true">
    <img
      src="/img/house/footer-floor-1200.webp"
      srcset="/img/house/footer-floor-1200.webp 1200w, /img/house/footer-floor-2400.webp 2400w"
      sizes="100vw"
      width="2400"
      height="1030"
      alt=""
      loading="lazy"
      decoding="async"
    />
    <span class="bowl b1 plate">{t('footer.bowls.luka')}</span>
    <span class="bowl b2 plate">{t('footer.bowls.budy')}</span>
    <span class="bowl b3 plate">{t('footer.bowls.caddy')}</span>
  </div>
  <div class="container inner">
    <div class="brand">
      <p class="mark">Three <span>To</span> Tango</p>
      <p class="ai">{t('footer.aiNote')}</p>
      <p class="bts">{t('footer.bts')} <a href="/behind-the-scenes">{t('footer.btsLink')}</a></p>
    </div>
    <div>
      <p class="h">{t('footer.follow')}</p>
      <ul class="social">
        {follow.map((l) => <li><a class="btn btn-ghost" href={l.href} rel="noopener" target="_blank">{l.label}</a></li>)}
      </ul>
    </div>
    <ul class="pages">
      {pages.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <p class="copy">&copy; {new Date().getFullYear()} {t('footer.copyright')}</p>
  </div>
</footer>

<style>
  /* The footer is the floor of Nora's house: skirting, the rug's edge, three bowls, Caddy asleep. */
  .site-footer {
    padding-block: 0 var(--space-4);
    background:
      repeating-linear-gradient(90deg, rgb(0 0 0 / 0%) 0 180px, rgb(0 0 0 / 22%) 180px 182px),
      linear-gradient(180deg, #3b2a1a, #2a1d12);
    color: var(--c-paper-2);
  }
  .floor {
    --h: clamp(150px, 18vw, 270px);
    position: relative;
    block-size: var(--h);
    margin-block-end: var(--space-4);
    overflow: hidden;
    box-shadow: 0 -1px 0 rgb(201 164 92 / 35%);
  }
  .floor img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 80%;
  }
  .floor::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    block-size: 30%;
    background: linear-gradient(to bottom, transparent, #3b2a1a);
  }
  .bowl {
    position: absolute;
    z-index: 1;
    inset-block-start: calc(0.8 * var(--h) - 3.4vw + 22px);
    transform: translateX(-50%);
    font-size: 0.62rem;
  }
  .b1 {
    left: 32%;
  }
  .b2 {
    left: 42.5%;
  }
  .b3 {
    left: 55%;
  }
  @media (max-width: 40rem) {
    .bowl {
      display: none;
    }
  }
  .inner {
    display: grid;
    gap: var(--space-4) var(--space-5);
  }
  @media (min-width: 52rem) {
    .inner {
      grid-template-columns: 1.4fr 1fr;
    }
    .pages,
    .copy {
      grid-column: 1 / -1;
    }
  }
  p {
    margin: 0 0 var(--space-1);
    max-inline-size: 34rem;
  }
  .mark {
    font: 600 1.6rem var(--font-display);
    color: var(--c-paper);
    margin-block-end: var(--space-2);
  }
  .mark span {
    color: var(--c-mustard);
  }
  .h {
    font: 600 1.1rem var(--font-display);
    color: var(--c-paper);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .social {
    gap: var(--space-1);
  }
  .social .btn {
    min-block-size: 2.6rem;
    font-size: 1rem;
  }
  .pages {
    padding-block-start: var(--space-3);
    border-block-start: 1px solid rgb(244 233 216 / 12%);
  }
  .pages a,
  .bts a {
    color: var(--c-paper);
    font-weight: 600;
  }
  .copy {
    font-size: var(--step--1);
  }
</style>
