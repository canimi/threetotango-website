---
import { questions, quizCats } from '../data/quiz';
import { characters } from '../data/characters';
import { t } from '../i18n/t';
---

<div
  class="quiz paper"
  data-quiz
  data-questions={JSON.stringify(questions)}
  data-label-progress={t('quiz.progress')}
  data-label-of={t('quiz.of')}
>
  <section class="start" data-start>
    <p>{t('quiz.intro')}</p>
    <button type="button" class="btn" data-start-btn>{t('quiz.start')}</button>
    <noscript>
      <p>{t('quiz.noscript')}</p>
      <ul>
        {
          quizCats.map((id) => (
            <li>
              <a href={`/quiz/${id}`}>{characters[id].name}</a>
            </li>
          ))
        }
      </ul>
    </noscript>
  </section>

  <section class="play" data-play hidden aria-live="polite">
    <p class="progress-text" data-progress-text></p>
    <progress
      class="bar"
      data-progress
      max={questions.length}
      value="0"
      aria-label={t('quiz.progressLabel')}></progress>
    <h2 class="q" data-q tabindex="-1"></h2>
    <div class="answers" data-answers></div>
    <button type="button" class="back" data-back>&larr; {t('quiz.back')}</button>
  </section>
</div>

<script>
  import { scoreQuiz, parseStart } from '../lib/quiz-score';
  import { track } from '../lib/track';
  import type { QuizQuestion } from '../data/quiz';

  const root = document.querySelector<HTMLElement>('[data-quiz]');
  if (root) {
    const qs: QuizQuestion[] = JSON.parse(root.dataset.questions ?? '[]');
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const start = $('[data-start]');
    const play = $('[data-play]');
    const text = $('[data-progress-text]');
    const bar = $<HTMLProgressElement>('[data-progress]');
    const q = $('[data-q]');
    const list = $('[data-answers]');
    const back = $<HTMLButtonElement>('[data-back]');
    const picks: number[] = [];
    const { labelProgress = '', labelOf = '' } = root.dataset;

    const render = () => {
      const i = picks.length;
      const cur = qs[i];
      text.textContent = `${labelProgress} ${i + 1} ${labelOf} ${qs.length}`;
      bar.value = i + 1;
      q.textContent = cur.text;
      list.replaceChildren(
        ...cur.answers.map((a, idx) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'answer';
          b.textContent = a.text;
          b.addEventListener('click', () => {
            picks.push(idx);
            if (picks.length === qs.length) {
              const result = scoreQuiz(picks);
              track('quiz-done', { cat: result });
              location.assign(`/quiz/${result}`);
            } else {
              render();
            }
          });
          return b;
        }),
      );
      back.hidden = i === 0;
      q.focus();
    };

    $('[data-start-btn]').addEventListener('click', () => {
      start.hidden = true;
      play.hidden = false;
      render();
    });
    // Coming from the inline first question on the home page: resume at question 2.
    const first = parseStart(location.search, qs);
    if (first !== null) {
      picks.push(first);
      start.hidden = true;
      play.hidden = false;
      render();
    }

    back.addEventListener('click', () => {
      if (picks.length > 0) {
        picks.pop();
        render();
      }
    });
  }
</script>

<style>
  .quiz {
    max-inline-size: 40rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 1rem + 3vw, 3rem);
  }
  .start {
    text-align: center;
  }
  .start p {
    font-size: 1.15rem;
  }
  .start ul {
    list-style: none;
    padding: 0;
  }
  .progress-text {
    margin: 0 0 0.4rem;
    color: var(--c-ink-2);
    font-weight: 600;
  }
  .bar {
    appearance: none;
    inline-size: 100%;
    block-size: 0.5rem;
    border: 0;
    border-radius: 999px;
    overflow: hidden;
    background: rgb(59 42 26 / 12%);
  }
  .bar::-webkit-progress-bar {
    background: rgb(59 42 26 / 12%);
  }
  .bar::-webkit-progress-value {
    background: var(--c-mustard);
    border-radius: 999px;
  }
  .bar::-moz-progress-bar {
    background: var(--c-mustard);
    border-radius: 999px;
  }
  .q {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.4rem, 1.2rem + 1vw, 1.8rem);
    color: var(--c-ink);
    margin-block: var(--space-3) var(--space-2);
  }
  .q:focus {
    outline: none;
  }
  .answers {
    display: grid;
    gap: var(--space-1);
  }
  .answers :global(.answer) {
    text-align: start;
    padding: 0.95rem 1.25rem;
    border: 0;
    border-radius: 18px;
    background: var(--c-cream);
    box-shadow: inset 0 0 0 2px rgb(59 42 26 / 14%);
    color: var(--c-ink);
    font: 600 1rem/1.4 var(--font-body);
    cursor: pointer;
  }
  .answers :global(.answer:hover),
  .answers :global(.answer:focus-visible) {
    background: var(--c-mustard);
    box-shadow: inset 0 0 0 2px var(--c-mustard);
  }
  .back {
    margin-block-start: var(--space-2);
    background: none;
    border: 0;
    color: var(--c-ink-2);
    font: inherit;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
  }
  [hidden] {
    display: none !important;
  }
</style>
