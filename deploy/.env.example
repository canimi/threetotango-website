# Variables for the Portainer stack (Stacks > Add stack > Environment variables).

# Name of the Docker network the n8n stack uses (Portainer > Networks). Default is fine for "n8n-docker".
N8N_NETWORK=n8n-docker_default

# Where the site fetches the episode list at build time (n8n webhook). Optional; build works if unreachable.
EPISODES_API_URL=http://n8n-docker-n8n-1:5678/webhook/ttw-episodes

# Umami website ID (from the Umami dashboard after creating the website). Leave empty until then.
PUBLIC_UMAMI_ID=

# Umami database user/password on the existing Postgres (database name: umami).
UMAMI_DB_USER=umami
UMAMI_DB_PASSWORD=change-me

# Random secret for Umami sessions, e.g. output of: openssl rand -hex 32
UMAMI_APP_SECRET=change-me

# Contract (not a variable): the episode API (ttw-episodes) must return thumbnail URLs that are
# local paths under /media/thumbs/ (the import workflow mirrors every thumbnail there, because
# Instagram CDN URLs expire and the CSP only allows self, data:, blob: and i.ytimg.com images).

# Shared secret for the internal media endpoint (http://ttw-web:8081/media/). n8n must send it
# in the X-TTW-Key header on PUT/DELETE. Random value, e.g. output of: openssl rand -hex 24
TTW_MEDIA_KEY=change-me
