# Rendered by the nginx image entrypoint (envsubst) to /etc/nginx/conf.d/ttw-proxy.inc (not *.conf, so not auto-loaded).
# Only the TTW_PROXY_KEY variable is substituted. proxy_set_header replaces any client-sent value of this header.
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $ttw_real_ip;
proxy_set_header X-Forwarded-For $ttw_real_ip;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-TTW-Proxy-Key "${TTW_PROXY_KEY}";
proxy_connect_timeout 5s;
proxy_request_buffering on;
include /etc/nginx/snippets/ttw-security.conf;
