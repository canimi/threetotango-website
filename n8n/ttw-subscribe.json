        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const j = $input.first().json;\nconst b = (j.body && typeof j.body === 'object') ? j.body : j;\nconst token = String(b.token == null ? '' : b.token);\nconst kind = String(b.kind == null ? '' : b.kind);\nconst rawGen = b.generationId == null ? '' : String(b.generationId);\nconst generationId = rawGen === '' ? null : rawGen;\nconst kindOk = ['hd', 'mug', 'credits'].includes(kind);\nconst genOk = generationId === null || /^[A-Za-z0-9_-]{1,64}$/.test(generationId);\nreturn [{ json: { token, kind, generationId, bad: !(kindOk && genOk) } }];"
      }
