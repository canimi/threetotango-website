        "query": "with cnt as (select count(*)::int as c from ttw.email_codes where lower(email) = $1 and sent_at > now() - interval '1 hour'), gen as (select lpad((abs((('x' || substr(replace(gen_random_uuid()::text, '-', ''), 1, 8))::bit(32)::bigint)) % 1000000)::text, 6, '0') as code), ins as (insert into ttw.email_codes (email, code_hash) select $1, encode(sha256(convert_to($1 || ':' || gen.code, 'UTF8')), 'hex') from cnt, gen where cnt.c < 3 returning id), sub as (insert into ttw.subscribers (email, source) select $1, $2 from cnt where c < 3 on conflict (lower(email)) do nothing returning id) select (select c from cnt) as recent, exists (select 1 from ins) as stored, (select code from gen) as code",
