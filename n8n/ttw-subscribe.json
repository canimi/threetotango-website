      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "with prev as (select verified_at from ttw.subscribers where lower(email) = $1), latest as (select id, code_hash, expires_at, attempts from ttw.email_codes where lower(email) = $1 order by sent_at desc, id desc limit 1), st as (select id, case when expires_at <= now() then 'expired' when attempts >= 5 then 'locked' when code_hash = encode(sha256(convert_to($1 || ':' || $2, 'UTF8')), 'hex') then 'ok' else 'wrong' end as s from latest), tok as (select translate(encode(decode(replace(gen_random_uuid()::text || gen_random_uuid()::text, '-', ''), 'hex'), 'base64'), '+/=', '-_') as t), bump as (update ttw.email_codes set attempts = attempts + 1 where id = (select id from st where s = 'wrong') returning id), del as (delete from ttw.email_codes where lower(email) = $1 and exists (select 1 from st where s = 'ok') returning id), ver as (update ttw.subscribers set verified_at = coalesce(verified_at, now()) where lower(email) = $1 and exists (select 1 from st where s = 'ok') returning id), ses as (insert into ttw.sessions (token_hash, email, expires_at) select encode(sha256(convert_to(tok.t, 'UTF8')), 'hex'), $1, now() + interval '24 hours' from tok where exists (select 1 from st where s = 'ok') returning token_hash) select coalesce((select s from st), 'expired') as status, ((select s from st) = 'ok' and exists (select 1 from prev where verified_at is null)) as first_verify, case when (select s from st) = 'ok' then (select t from tok) end as token",
        "options": {
          "queryReplacement": "={{ [$json.email, $json.code] }}"
        }
      }
