        "jsCode": "const j = $input.first().json;\nconst b = (j.body && typeof j.body === 'object') ? j.body : j;\nconst email = String(b.email == null ? '' : b.email).trim().toLowerCase();\nconst code = String(b.code == null ? '' : b.code).trim();\nconst emailOk = email.length <= 254 && /^[^\\s@,;<>\"']+@[^\\s@,;<>\"']+\\.[^\\s@,;<>\"']{2,}$/.test(email);\nconst codeOk = /^[0-9]{6}$/.test(code);\nreturn [{ json: { emailOk, codeOk, email, code } }];"
